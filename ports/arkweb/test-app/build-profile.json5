{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "OpenHarmony",
        "material": {
          "certpath": "./signing/OpenHarmonyApplication.pem",
          "keyAlias": "openharmony application release",
          "keyPassword": "123456",
          "profile": "./signing/profile-debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "./signing/OpenHarmony.p12",
          "storePassword": "123456"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compileSdkVersion": 26,
        "targetSdkVersion": 26,
        "compatibleSdkVersion": 20,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}