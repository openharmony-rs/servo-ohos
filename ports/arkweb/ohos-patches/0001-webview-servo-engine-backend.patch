+namespace {
+constexpr int SERVO_ARKWEB_EXPECTED_ABI_VERSION = 1;
+constexpr char SERVO_ARKWEB_DEFAULT_LIB[] = "/system/lib64/libservo_arkweb.so";
+
+using ServoAbiVersionFn = int (*)();
+using ServoCreateEngineFn = OHOS::NWeb::NWebEngine* (*)();
+
+// dlopen the Servo shim and hand back its NWebEngine, or nullptr on any failure (with a logged
+// reason). On success the library handle is intentionally leaked: the engine is a process-wide
+// singleton that lives for the lifetime of the process, so the shim must never be unloaded.
+OHOS::NWeb::NWebEngine* LoadServoWebEngine()
+{
+    std::string libPath = OHOS::system::GetParameter("web.engine.servo.path", SERVO_ARKWEB_DEFAULT_LIB);
+
+    // RTLD_LOCAL: the shim is self-contained (statically links its Rust/C++ dependencies) and only
+    // its two factory symbols are resolved here via dlsym on the returned handle, which works
+    // regardless of scope. Keeping its symbols out of the global scope avoids collisions with the
+    // host process (e.g. ICU, EGL loader) in the app.
+    dlerror();
+    void* handle = dlopen(libPath.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (handle == nullptr) {
+        WVLOG_E("servo: dlopen('%{public}s') failed: %{public}s", libPath.c_str(), dlerror());
+        return nullptr;
+    }
+
+    dlerror();
+    auto abiVersionFn = reinterpret_cast<ServoAbiVersionFn>(dlsym(handle, "servo_arkweb_abi_version"));
+    if (abiVersionFn == nullptr) {
+        WVLOG_E("servo: symbol 'servo_arkweb_abi_version' not found: %{public}s", dlerror());
+        dlclose(handle);
+        return nullptr;
+    }
+
+    int abiVersion = abiVersionFn();
+    if (abiVersion != SERVO_ARKWEB_EXPECTED_ABI_VERSION) {
+        WVLOG_E("servo: ABI version mismatch, shim reports %{public}d, host expects %{public}d",
+            abiVersion, SERVO_ARKWEB_EXPECTED_ABI_VERSION);
+        dlclose(handle);
+        return nullptr;
+    }
+
+    dlerror();
+    auto createEngineFn =
+        reinterpret_cast<ServoCreateEngineFn>(dlsym(handle, "servo_arkweb_create_nweb_engine"));
+    if (createEngineFn == nullptr) {
+        WVLOG_E("servo: symbol 'servo_arkweb_create_nweb_engine' not found: %{public}s", dlerror());
+        dlclose(handle);
+        return nullptr;
+    }
+
+    OHOS::NWeb::NWebEngine* engine = createEngineFn();
+    if (engine == nullptr) {
+        WVLOG_E("servo: factory 'servo_arkweb_create_nweb_engine' returned nullptr");
+        dlclose(handle);
+        return nullptr;
+    }
+
+    WVLOG_I("servo: loaded web engine from %{public}s (abi %{public}d)", libPath.c_str(), abiVersion);
+    return engine;
+}
+}  // namespace
