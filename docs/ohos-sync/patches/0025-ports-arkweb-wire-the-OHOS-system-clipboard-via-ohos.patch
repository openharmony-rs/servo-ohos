+            preferences.network_https_proxy_uri = proxy;
         }
-        let servo = builder.build();
+        let servo = ServoBuilder::default()
+            .opts(opts)
+            .event_loop_waker(waker)
+            .preferences(preferences)
+            .build();
         ServoThread {
             servo,
             webviews: HashMap::new(),
