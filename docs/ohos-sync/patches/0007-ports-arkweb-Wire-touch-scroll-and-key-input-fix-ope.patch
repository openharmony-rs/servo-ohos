diff --git a/ports/arkweb/cpp/servo_nweb_engine.h b/ports/arkweb/cpp/servo_nweb_engine.h
index 31c81877ce9..4b68fe3775b 100644
--- a/ports/arkweb/cpp/servo_nweb_engine.h
+++ b/ports/arkweb/cpp/servo_nweb_engine.h
@@ -30,7 +30,10 @@ public:
 
