 struct BuiltWebView {
     webview: WebView,
+    /// Owns the `OH_NativeVSync` handle; dropped (unsubscribing) when this webview is destroyed.
+    refresh_driver: Rc<VsyncRefreshDriver>,
 }
 
 struct WebViewEntry {
