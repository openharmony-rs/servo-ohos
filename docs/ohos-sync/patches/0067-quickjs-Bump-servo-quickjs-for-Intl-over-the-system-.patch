diff --git a/python/servo/platform/linux_packages/xbps/xbps_base.txt b/python/servo/platform/linux_packages/xbps/xbps_base.txt
index 3c759c556ad..e66bc22ba0c 100644
--- a/python/servo/platform/linux_packages/xbps/xbps_base.txt
+++ b/python/servo/platform/linux_packages/xbps/xbps_base.txt
@@ -20,6 +20,7 @@ libXmu-devel
 dbus-devel
 ncurses-devel
 harfbuzz-devel
+icu-devel
 ccache
