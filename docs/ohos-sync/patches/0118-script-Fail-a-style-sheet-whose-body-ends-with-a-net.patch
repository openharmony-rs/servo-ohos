diff --git a/tests/wpt/mozilla/tests/mozilla/resources/stylesheet-network-error.py b/tests/wpt/mozilla/tests/mozilla/resources/stylesheet-network-error.py
new file mode 100644
index 00000000000..1d025bac32f
--- /dev/null
+++ b/tests/wpt/mozilla/tests/mozilla/resources/stylesheet-network-error.py
@@ -0,0 +1,21 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+stylesheet = b"#target { color: rgb(0, 128, 0); }\n"
+
+
+def main(request, response):
+    response.add_required_headers = False
+    output = b"HTTP/1.1 200 OK\r\n"
+    output += b"Content-Type: text/css\r\n"
+    output += b"Connection: close\r\n"
+    if request.GET.first(b"error") == b"decode":
+        output += b"Content-Encoding: gzip\r\n"
+        output += b"Content-Length: %d\r\n" % len(stylesheet)
+    else:
+        output += b"Content-Length: %d\r\n" % (len(stylesheet) + 8)
+    output += b"\r\n"
+    output += stylesheet
+    response.writer.write(output)
+    response.close_connection = True
diff --git a/tests/wpt/mozilla/tests/mozilla/stylesheet-network-error.html b/tests/wpt/mozilla/tests/mozilla/stylesheet-network-error.html
new file mode 100644
index 00000000000..264085b73ad
--- /dev/null
+++ b/tests/wpt/mozilla/tests/mozilla/stylesheet-network-error.html
@@ -0,0 +1,39 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>A style sheet whose body ends with a network error is a failure</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<div id="target"></div>
+<script>
+function load(t, element) {
+  const event = new Promise(resolve => {
+    element.onload = element.onerror = e => resolve(e.type);
+  });
+  document.head.append(element);
+  t.add_cleanup(() => element.remove());
+  return event;
+}
+
+for (const [error, description] of [
+  ["decode", "fails to decode"],
+  ["cut-short", "is cut short"],
+]) {
+  promise_test(async t => {
+    const link = document.createElement("link");
+    link.rel = "stylesheet";
+    link.href = `resources/stylesheet-network-error.py?error=${error}&from=link`;
+    assert_equals(await load(t, link), "error", "event");
+    assert_equals(getComputedStyle(document.getElementById("target")).color, "rgb(0, 0, 0)",
+                  "color");
+  }, `A link fires error and applies no style when the body of its style sheet ${description}`);
+
+  promise_test(async t => {
+    const style = document.createElement("style");
+    style.textContent =
+      `@import url("resources/stylesheet-network-error.py?error=${error}&from=import");`;
+    assert_equals(await load(t, style), "error", "event");
+    assert_equals(getComputedStyle(document.getElementById("target")).color, "rgb(0, 0, 0)",
+                  "color");
+  }, `A style element fires error and applies no style when the body of an imported style sheet ${description}`);
+}
+</script>
