-              python ./python/servo/try_parser.py ${{ github.event_name == 'pull_request' && 'linux-unit-tests lint' || github.event_name == 'push' && 'full' || 'fail-fast linux-wpt ohos' }}
+              python ./python/servo/try_parser.py ${{ github.event_name == 'pull_request' && 'linux-unit-tests lint' || github.event_name == 'push' && 'full' || 'fail-fast linux-wpt ohos quickjs' }}
