diff --git a/ports/arkweb/Cargo.toml b/ports/arkweb/Cargo.toml
new file mode 100644
index 00000000000..8f60fb1338c
--- /dev/null
+++ b/ports/arkweb/Cargo.toml
@@ -0,0 +1,35 @@
+[package]
+name = "arkweb"
+version.workspace = true
+authors.workspace = true
+license.workspace = true
+edition.workspace = true
+publish = false
+rust-version.workspace = true
+repository.workspace = true
+description = "Servo as an alternative ArkWeb (OpenHarmony) webview backend."
+
+[lib]
+name = "servo_arkweb"
+crate-type = ["cdylib"]
+
+# All runtime dependencies are gated on the OpenHarmony target environment. On any
+# other target (e.g. host `./mach check`) this crate compiles to an empty library.
+# Note: freetype is bundled (compiled from source) by default on ohos; there is no
+# `bundled_freetype` servo feature. `dynamic_freetype` would opt into dynamic linking.
+[target.'cfg(target_env = "ohos")'.dependencies]
+servo = { workspace = true, default-features = false, features = ["js_jit"] }
+cxx = { workspace = true }
+dpi = { workspace = true }
+hilog = { workspace = true }
+# force inprocess: ohos is single-process for now, mirroring servoshell.
+ipc-channel = { workspace = true, features = ["force-inprocess"] }
+log = { workspace = true }
+ohos-vsync = { workspace = true }
+raw-window-handle = { workspace = true }
+# aws-lc-rs: the crypto provider Servo's rustls-based networking needs installed for TLS.
+rustls = { workspace = true, features = ["aws-lc-rs"] }
+url = { workspace = true }
+
+[build-dependencies]
+cxx-build = { workspace = true }
diff --git a/ports/arkweb/build.rs b/ports/arkweb/build.rs
new file mode 100644
index 00000000000..56a24e9179d
--- /dev/null
+++ b/ports/arkweb/build.rs
@@ -0,0 +1,40 @@
+fn main() {
+    // The ArkWeb port only produces a functional library for OpenHarmony targets.
+    // On any other target (e.g. host `./mach check`) this crate is an empty library,
+    // so skip all C++/cxx bridge compilation.
+    if std::env::var("CARGO_CFG_TARGET_ENV").as_deref() != Ok("ohos") {
+        return;
+    }
+
+    let manifest_dir = std::env::var("CARGO_MANIFEST_DIR").unwrap();
+    let prelude = format!("{manifest_dir}/cpp/arkweb_prelude.h");
+
+    let cpp_files = [
+        "cpp/entry.cpp",
+        "cpp/servo_nweb_engine.cpp",
+        "cpp/servo_nweb.cpp",
+        "cpp/servo_handler_proxy.cpp",
+        "cpp/servo_stub_managers.cpp",
+    ];
+
+    cxx_build::bridge("src/bridge.rs")
+        .files(cpp_files)
+        .include("vendor")
+        .include("cpp")
+        .std("c++17")
+        // Force-include standard headers the vendored OHOS headers assume (see prelude).
+        .flag("-include")
+        .flag(&prelude)
+        // nweb_drag_data.h sets an `enum class : unsigned char` enumerator to UINT_MAX; the
+        // wrapped value is never used but the narrowing would otherwise be a hard error.
+        .flag_if_supported("-Wno-c++11-narrowing")
+        .flag_if_supported("-Wno-narrowing")
+        .compile("servo_arkweb_cpp");
+
+    println!("cargo:rerun-if-changed=src/bridge.rs");
+    for file in cpp_files {
