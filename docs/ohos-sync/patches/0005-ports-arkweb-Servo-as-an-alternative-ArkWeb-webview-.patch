+     */
+    virtual std::string StandardFontFamilyName() = 0;
+
+    /**
+     * Get the user-agent string to the nweb.
+     *
+     * @see PutUserAgent
+     */
+    virtual std::string UserAgent() = 0;
+
+    /**
+     * Get the zoom percentage of the page text.
