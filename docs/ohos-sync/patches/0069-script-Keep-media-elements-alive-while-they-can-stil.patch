+<!DOCTYPE html>
+<meta charset="utf-8">
+<title>Media elements keep playing when all references to them have been removed</title>
+<link rel="help" href="https://html.spec.whatwg.org/multipage/media.html#playing-the-media-resource">
+<meta name="timeout" content="long">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script src="/common/gc.js"></script>
+<script src="/common/media.js"></script>
+<body>
+<script>
+// "Media elements must not stop playing just because all references to them have been removed;
+// only once a media element is in a state where no further audio could ever be played by that
+// element may the element be garbage collected."
+//
+// Each test creates a media element that is not in a document and keeps no reference to it: only
+// the element's own event listeners see it. The test forces a garbage collection while the
+// element can still play audio or fire events, then waits for the element to carry on. The tests
+// run in parallel, so that an element that is collected only times out its own test.
+
+const AUDIO_SRC = getAudioURI("/media/sound_5"); // audio only, 5 s
+const VIDEO_SRC = getVideoURI("/media/test-1s"); // audio and video, 1 s
+const SILENT_VIDEO_SRC = getVideoURI("/media/white"); // video without audio, 10 s
+const SRC = { audio: AUDIO_SRC, video: VIDEO_SRC };
+
+// Forwards events of an unreferenced media element to whoever waits for them. It must not keep
+// the element, so it hands out copies of the values the tests need, never the element.
+class MediaEventObserver {
+  #waiters = [];
+
+  // Resolves with the element's currentTime at the next `type` event for which `predicate`
+  // returns true, and rejects at the next `error` event.
+  next(type, predicate = () => true) {
+    return new Promise((resolve, reject) => {
+      this.#waiters.push({ type, predicate, resolve, reject });
+    });
+  }
+
+  fail(error) {
+    for (const waiter of this.#waiters.splice(0)) {
+      waiter.reject(error);
+    }
+  }
+
+  dispatch(event) {
+    const element = event.target;
+    if (event.type == "error") {
+      this.fail(new Error(`error event, MediaError code ${element.error?.code}`));
+      return;
+    }
+    this.#waiters = this.#waiters.filter(waiter => {
+      if (waiter.type != event.type || !waiter.predicate(element)) {
+        return true;
+      }
+      waiter.resolve(element.currentTime);
+      return false;
+    });
+  }
+}
+
+// `start` is one of:
+// - "play": call play();
+// - "autoplay": set the autoplay attribute;
+// - "play-on-canplay": call play() from a canplay listener.
+function unreferencedMediaElement(tagName, src, start) {
+  const observer = new MediaEventObserver();
+  createDetachedElement(tagName, src, start, observer);
+  return observer;
+}
+
+// A separate function, so that nothing that outlives the call refers to the element.
+function createDetachedElement(tagName, src, start, observer) {
+  const element = document.createElement(tagName);
+  for (const type of ["playing", "timeupdate", "ended", "error"]) {
+    element.addEventListener(type, event => observer.dispatch(event));
+  }
+  const play = target => target.play().catch(error => observer.fail(error));
+  if (start == "autoplay") {
+    element.autoplay = true;
+  } else if (start == "play-on-canplay") {
+    element.addEventListener("canplay", event => play(event.target), { once: true });
+  }
+  element.src = src;
+  if (start == "play") {
+    play(element);
+  }
+}
+
+function parallel_test(func, name) {
+  async_test(t => {
+    func().then(() => t.done(), t.step_func(error => { throw error; }));
+  }, name);
+}
+
+for (const tagName of ["audio", "video"]) {
+  parallel_test(async () => {
+    const media = unreferencedMediaElement(tagName, SRC[tagName], "play");
+    await media.next("playing");
+    const ended = media.next("ended");
+    await garbageCollect();
+    await ended;
+  }, `An unreferenced ${tagName} element that is playing keeps playing until it ends`);
+
+  parallel_test(async () => {
+    const media = unreferencedMediaElement(tagName, SRC[tagName], "play");
+    const playing = media.next("playing");
+    const ended = media.next("ended");
+    await garbageCollect();
+    await playing;
+    await ended;
+  }, `An unreferenced ${tagName} element that is loading after play() starts playing`);
+}
+
+parallel_test(async () => {
+  const media = unreferencedMediaElement("audio", AUDIO_SRC, "autoplay");
+  const playing = media.next("playing");
+  await garbageCollect();
+  await playing;
+  const ended = media.next("ended");
+  await garbageCollect();
+  await ended;
+}, "An unreferenced audio element that is eligible for autoplay plays until it ends");
+
+parallel_test(async () => {
+  const media = unreferencedMediaElement("audio", AUDIO_SRC, "play-on-canplay");
+  const playing = media.next("playing");
+  await garbageCollect();
+  await playing;
+  const ended = media.next("ended");
+  await garbageCollect();
+  await ended;
+}, "An unreferenced audio element that is buffering, with a listener that starts playback, " +
+   "plays until it ends");
+
+parallel_test(async () => {
+  const media = unreferencedMediaElement("video", SILENT_VIDEO_SRC, "play");
+  const start = await media.next("playing");
+  const progressed = media.next("timeupdate", element => element.currentTime >= start + 1);
+  await garbageCollect();
+  await progressed;
+}, "An unreferenced video element without audio tracks, with event listeners, keeps playing");
+</script>
+</body>
