+        );
+
+        let (path, created) = handle
+            .create_database(storage_proxy_map.bottle_id, "ohos-rdb".to_string())
+            .recv()
+            .unwrap()
+            .unwrap();
+
+        assert!(created);
+        assert!(path.is_dir());
+
+        let registry_path = registry_db_path(&tmp_dir);
+        assert_eq!(
