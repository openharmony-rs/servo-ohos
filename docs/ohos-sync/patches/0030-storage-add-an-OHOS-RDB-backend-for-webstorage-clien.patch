+
+    unsafe extern "C" fn go_to_next_row(_: *mut OH_Cursor) -> c_int {
+        let next = ROW_INDEX.fetch_add(1, Ordering::SeqCst) + 1;
+        if next < 2 {
+            OH_Rdb_ErrCode::RDB_OK.0
