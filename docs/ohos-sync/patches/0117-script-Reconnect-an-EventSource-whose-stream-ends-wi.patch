diff --git a/tests/wpt/mozilla/tests/mozilla/eventsource-network-error.window.js b/tests/wpt/mozilla/tests/mozilla/eventsource-network-error.window.js
new file mode 100644
index 00000000000..63b227f44da
--- /dev/null
+++ b/tests/wpt/mozilla/tests/mozilla/eventsource-network-error.window.js
@@ -0,0 +1,17 @@
+async_test(t => {
+  const source = new EventSource("resources/eventsource-network-error.py");
+  t.add_cleanup(() => source.close());
+  const events = [];
+  source.onopen = t.step_func(() => {
+    events.push("open");
+    if (events.length > 1) {
+      assert_array_equals(events, ["open", "message", "error", "open"]);
+      t.done();
+    }
+  });
+  source.onmessage = t.step_func(() => events.push("message"));
+  source.onerror = t.step_func(() => {
+    events.push("error");
+    assert_equals(source.readyState, EventSource.CONNECTING, "readyState");
+  });
+}, "EventSource reestablishes the connection when the event stream ends with a network error");
diff --git a/tests/wpt/mozilla/tests/mozilla/resources/eventsource-network-error.py b/tests/wpt/mozilla/tests/mozilla/resources/eventsource-network-error.py
new file mode 100644
index 00000000000..8a5953ab3c8
--- /dev/null
+++ b/tests/wpt/mozilla/tests/mozilla/resources/eventsource-network-error.py
@@ -0,0 +1,20 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+
+def main(request, response):
+    response.add_required_headers = False
+    event = b"retry: 10\ndata: event\n\n"
+    response.writer.write(
+        b"HTTP/1.1 200 OK\r\n"
+        b"Content-Type: text/event-stream\r\n"
+        b"Transfer-Encoding: chunked\r\n"
+        b"Connection: close\r\n"
+        b"\r\n"
+        b"%x\r\n%s\r\n"
+        # The connection closes in the middle of the next chunk.
+        b"100\r\ndata: cut"
+        % (len(event), event)
+    )
+    response.close_connection = True
