+    db.upgrade_version(txn(2), 2);
+    let mut new_indexes = Vec::new();
+    for (kind, (name, unique, multi_entry)) in options.iter().enumerate() {
+        let index = indexes[2] + 1 + kind as i64;
+        let events = run_upgrade_batch(
+            &db,
+            2,
+            vec![create_populated_index(
