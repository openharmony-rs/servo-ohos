+++ b/.github/workflows/dispatch-workflow.yml
@@ -165,3 +165,4 @@ jobs:
       profile: ${{ inputs.profile }}
       wpt: ${{ inputs.wpt }}
       wpt-args: ${{ inputs.wpt-args }}
+      number-of-wpt-chunks: ${{ inputs.number-of-wpt-chunks }}
diff --git a/.github/workflows/linux-wpt.yml b/.github/workflows/linux-wpt.yml
index 46feb0c5001..803f8839099 100644
--- a/.github/workflows/linux-wpt.yml
+++ b/.github/workflows/linux-wpt.yml
@@ -21,6 +21,11 @@ on:
         required: true
         default: ""
         type: string
+      name:
+        description: Distinguishes the artifacts and the report of this run from other WPT runs of the workflow run
+        default: linux
+        required: false
+        type: string
 
 env:
   RUST_BACKTRACE: 1
@@ -82,10 +87,10 @@ jobs:
       - uses: servo/ci-runners/actions/checkout@b42c96524cdd72126255602c69c4ad649c750ebf
       - uses: actions/download-artifact@v8
         with:
-          name: ${{ inputs.profile }}-binary-linux
-          path: ${{ inputs.profile }}-binary-linux
+          name: ${{ inputs.profile }}-binary-${{ inputs.name }}
+          path: ${{ inputs.profile }}-binary-${{ inputs.name }}
       - name: unPackage binary
-        run: tar -xzf ${{ inputs.profile }}-binary-linux/servo-tech-demo.tar.gz
+        run: tar -xzf ${{ inputs.profile }}-binary-${{ inputs.name }}/servo-tech-demo.tar.gz
       - name: Setup Python
         if: ${{ runner.environment != 'self-hosted' }}
         uses: ./.github/actions/setup-python
@@ -124,14 +129,14 @@ jobs:
         uses: actions/upload-artifact@v7
         if: ${{ always() }}
         with:
-          name: wpt-filtered-logs-linux-${{ matrix.chunk_id }}
+          name: wpt-filtered-logs-${{ inputs.name }}-${{ matrix.chunk_id }}
           path: wpt-filtered-logs/*/
           if-no-files-found: error
       - name: Archive results (full)
         uses: actions/upload-artifact@v7
         if: ${{ always() }}
         with:
-          name: wpt-full-logs-linux-${{ matrix.chunk_id }}
+          name: wpt-full-logs-${{ inputs.name }}-${{ matrix.chunk_id }}
           path: wpt-full-logs/*/
           if-no-files-found: error
 
@@ -144,22 +149,22 @@ jobs:
       - name: Merge logs (full)
         uses: actions/upload-artifact/merge@v7
         with:
-          name: wpt-full-logs-linux
-          pattern: wpt-full-logs-linux-*
+          name: wpt-full-logs-${{ inputs.name }}
+          pattern: wpt-full-logs-${{ inputs.name }}-*
           delete-merged: true
       # This job needs to be last. If no filtered results were uploaded, it will fail, but we want to merge other archives in that case.
       - name: Merge logs (filtered)
         uses: actions/upload-artifact/merge@v7
         with:
-          name: wpt-filtered-logs-linux
-          pattern: wpt-filtered-logs-linux-*
+          name: wpt-filtered-logs-${{ inputs.name }}
+          pattern: wpt-filtered-logs-${{ inputs.name }}-*
           delete-merged: true
       - uses: servo/ci-runners/actions/checkout@b42c96524cdd72126255602c69c4ad649c750ebf
         if: ${{ !cancelled() && !inputs.wpt-sync-from-upstream }}
       - uses: actions/download-artifact@v8
         if: ${{ !cancelled() && !inputs.wpt-sync-from-upstream }}
         with:
-          name: wpt-filtered-logs-linux
+          name: wpt-filtered-logs-${{ inputs.name }}
           path: results
       - name: Aggregate results
         if: ${{ !cancelled() && !inputs.wpt-sync-from-upstream }}
@@ -170,14 +175,14 @@ jobs:
         if: ${{ !cancelled() && !inputs.wpt-sync-from-upstream }}
         uses: actions/upload-artifact@v7
         with:
-          name: stable-unexpected-results-linux
+          name: stable-unexpected-results-${{ inputs.name }}
           path: stable-unexpected-results.log
           if-no-files-found: error
       - name: Report results
         if: ${{ !cancelled() && !inputs.wpt-sync-from-upstream }}
         run: |
           etc/ci/report_aggregated_expected_results.py \
-            --tag="linux-wpt" \
+            --tag="${{ inputs.name }}-wpt" \
             results/linux/*.json
         env:
           GITHUB_CONTEXT: ${{ toJson(github) }}
diff --git a/.github/workflows/quickjs.yml b/.github/workflows/quickjs.yml
index 2a29c84798e..eebc0db8bf6 100644
--- a/.github/workflows/quickjs.yml
+++ b/.github/workflows/quickjs.yml
@@ -1,7 +1,7 @@
-# Builds servoshell on the QuickJS mozjs shim (openharmony-rs/servo-quickjs) and runs WPT with it.
-# The results are compared against the SpiderMonkey expectations, so the unexpected results are
-# the gaps of the QuickJS backend; the WPT jobs succeed regardless. Pull requests and the merge
-# queue run the build and smoketest only (the `quickjs` job of the try configuration).
+# Builds servoshell on the QuickJS mozjs shim (openharmony-rs/servo-quickjs) and runs WPT with it,
+# against the expectations with their `js_engine == "quickjs"` conditions. Pull requests run WPT
+# on the directories of the Linux WPT job, and the whole suite when they change the shim pin
+# (python/servo/pr_jobs.py); the merge queue runs the build and smoketest only.
 name: QuickJS
 on:
   schedule:
@@ -19,6 +19,10 @@ on:
         default: ""
         required: false
         type: string
+      number-of-wpt-chunks:
+        default: 20
+        required: false
+        type: number
   workflow_dispatch:
     inputs:
       servo-quickjs-ref:
@@ -128,7 +132,7 @@ jobs:
         if: ${{ env.RUN_WPT == 'true' }}
         uses: actions/upload-artifact@v7
         with:
-          name: ${{ env.PROFILE }}-binary-linux
+          name: ${{ env.PROFILE }}-binary-quickjs
           path: target/${{ env.PROFILE }}/servo-tech-demo.tar.gz
           if-no-files-found: error
 
@@ -139,4 +143,6 @@ jobs:
     with:
       profile: ${{ inputs.profile || 'release' }}
       binary-path: servo/servoshell
-      wpt-args: --always-succeed ${{ inputs.wpt-args }}
+      number-of-wpt-chunks: ${{ inputs.number-of-wpt-chunks || 20 }}
+      name: quickjs
+      wpt-args: --js-engine quickjs ${{ inputs.wpt-args }}
diff --git a/python/servo/pr_jobs.py b/python/servo/pr_jobs.py
index e4f44d365be..ac3a88b6dad 100644
--- a/python/servo/pr_jobs.py
+++ b/python/servo/pr_jobs.py
@@ -12,10 +12,12 @@
 Every pull request runs the Linux unit tests and lint. On top of that:
 
 - OHOS code: the OHOS build. The Linux WPT run never executes that code.
-- The QuickJS workflow: the QuickJS build.
-- WPT tests or expectations: a Linux WPT run of the directories of those tests.
+- The QuickJS workflow or the servo-quickjs pin: the QuickJS build and the whole QuickJS WPT suite.
+- WPT tests or expectations: a Linux WPT run of the directories of those tests, with SpiderMonkey
+  and QuickJS.
 - Files that no build or test reads, such as documentation: nothing.
-- Anything else: the OHOS and QuickJS builds and the whole Linux WPT suite.
+- Anything else: the OHOS and QuickJS builds and the whole Linux WPT suite. The nightly QuickJS
+  workflow runs the whole QuickJS WPT suite.
 
 The path lists are explicit on purpose: a path missing from them only costs a full run.
 """
@@ -146,12 +148,24 @@ def select(changed: Iterable[str], count_files: Callable[[str], int]) -> Config:
         return Config(FULL)
 
     # The WPT run is added after the unit tests, so that both share one Linux job.
-    jobs = [ALWAYS, *(["ohos"] if ohos else []), *(["quickjs"] if quickjs else []), *(["linux-wpt"] if counts else [])]
+    jobs = [
+        ALWAYS,
+        *(["ohos"] if ohos else []),
+        *(["quickjs"] if quickjs or counts else []),
+        *(["linux-wpt"] if counts else []),
+    ]
     config = Config(" ".join(jobs))
+    wpt_args = " ".join(f"./{directory}" for directory in counts)
+    number_of_wpt_chunks = min(20, math.ceil(sum(counts.values()) / FILES_PER_CHUNK))
     for job in config.matrix:
-        if job.workflow is Workflow.LINUX and counts:
-            job.wpt_args = " ".join(f"./{directory}" for directory in counts)
-            job.number_of_wpt_chunks = min(20, math.ceil(sum(counts.values()) / FILES_PER_CHUNK))
+        if job.workflow is Workflow.QUICKJS:
+            job.wpt = True
+            # A change to the QuickJS build runs the whole suite.
+            if not quickjs:
+                job.wpt_args, job.number_of_wpt_chunks = wpt_args, number_of_wpt_chunks
+            job.update_name()
+        elif job.workflow is Workflow.LINUX and counts:
+            job.wpt_args, job.number_of_wpt_chunks = wpt_args, number_of_wpt_chunks
     return config
 
 
@@ -193,6 +207,7 @@ class TestSelect(unittest.TestCase):
     LINT = ("lint", False, False, "", 20)
     OHOS = ("ohos", False, False, "", 20)
     QUICKJS = ("quickjs", False, False, "", 20)
+    QUICKJS_WPT = ("quickjs", False, True, "", 20)
 
     def test_shared_code_runs_everything(self) -> None:
         full = json.loads(Config(FULL).to_json())
@@ -217,7 +232,13 @@ class TestSelect(unittest.TestCase):
     def test_quickjs_workflow(self) -> None:
         self.assertEqual(
             self.jobs(".github/workflows/quickjs.yml", "support/quickjs/cargo-config.toml", "ports/arkweb/src/lib.rs"),
