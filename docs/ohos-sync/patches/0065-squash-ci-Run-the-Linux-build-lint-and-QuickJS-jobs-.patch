From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Schwender <schwenderjonathan@gmail.com>
Date: Sun, 11 Oct 2026 12:00:58 +0000
Subject: [PATCH] squash! ci: Run the Linux build, lint and QuickJS jobs on the
 self-hosted runners

Pull requests from branches of this repository ran on GitHub-hosted runners.
`github.event.pull_request.head.repo.fork` is the head repository's fork
flag, and servo-ohos is a fork of servo/servo, so it is true for every pull
request. Compare the head repository with this one instead; without a pull
request (push, schedule, merge queue, dispatch) the runner stays self-hosted.

Validation: PR #25 (branch of this repository, Main run 38135694194) ran its Lint, Linux Build (x86_64) and Linux Build (QuickJS) jobs on ubuntu-22.04, and the API reports `"fork": true` for openharmony-rs/servo-ohos. actionlint 1.7.12 reports nothing new for the three workflows.
AI-assisted: Yes (agent session; diagnosed from the PR's job data and written by the agent)
Signed-off-by: Jonathan Schwender <schwenderjonathan@gmail.com>
---
 .github/workflows/lint.yml         | 2 +-
 .github/workflows/linux-common.yml | 5 +++--
 .github/workflows/quickjs.yml      | 2 +-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/lint.yml b/.github/workflows/lint.yml
index 242b70b2d07..5428e469b6b 100644
--- a/.github/workflows/lint.yml
+++ b/.github/workflows/lint.yml
@@ -14,7 +14,7 @@ jobs:
     # The self-hosted runners labelled servo-ohos-linux have the clippy artifacts of a recent
     # ohos-main. Pull requests from forks and runs while the repository variable
     # NO_SELF_HOSTED_RUNNERS is set use GitHub-hosted runners.
-    runs-on: ${{ (vars.NO_SELF_HOSTED_RUNNERS || github.event.pull_request.head.repo.fork) && 'ubuntu-22.04' || 'servo-ohos-linux' }}
+    runs-on: ${{ (vars.NO_SELF_HOSTED_RUNNERS || github.event.pull_request && github.event.pull_request.head.repo.full_name != github.repository) && 'ubuntu-22.04' || 'servo-ohos-linux' }}
     steps:
       - uses: servo/ci-runners/actions/checkout@b42c96524cdd72126255602c69c4ad649c750ebf
         with:
diff --git a/.github/workflows/linux-common.yml b/.github/workflows/linux-common.yml
index 36a296c5e07..24ec1273266 100644
--- a/.github/workflows/linux-common.yml
+++ b/.github/workflows/linux-common.yml
@@ -80,8 +80,9 @@ jobs:
     # The self-hosted runners labelled servo-ohos-linux have a target directory that is prebuilt
     # at a recent ohos-main. Pull requests from forks, architectures without self-hosted runners
     # (an empty self-hosted-image-name) and runs while the repository variable
-    # NO_SELF_HOSTED_RUNNERS is set use GitHub-hosted runners.
-    runs-on: ${{ (inputs.self-hosted-image-name == '' || inputs.force-github-hosted-runner || vars.NO_SELF_HOSTED_RUNNERS || github.event.pull_request.head.repo.fork) && inputs.github-runner-label || 'servo-ohos-linux' }}
+    # NO_SELF_HOSTED_RUNNERS is set use GitHub-hosted runners. `head.repo.fork` is no test for
+    # forks here: it is true for this repository too, a fork of servo/servo.
+    runs-on: ${{ (inputs.self-hosted-image-name == '' || inputs.force-github-hosted-runner || vars.NO_SELF_HOSTED_RUNNERS || github.event.pull_request && github.event.pull_request.head.repo.full_name != github.repository) && inputs.github-runner-label || 'servo-ohos-linux' }}
     outputs:
       artifact_ids: ${{ steps.artifact_ids.outputs.artifact_ids }}
     steps:
diff --git a/.github/workflows/quickjs.yml b/.github/workflows/quickjs.yml
index cf44953e7df..eebc0db8bf6 100644
--- a/.github/workflows/quickjs.yml
+++ b/.github/workflows/quickjs.yml
@@ -60,7 +60,7 @@ jobs:
     # labelled servo-ohos-linux do. Their target directory has the checked-release QuickJS build of
     # a recent ohos-main. Pull requests from forks and runs while the repository variable
     # NO_SELF_HOSTED_RUNNERS is set use GitHub-hosted runners.
-    runs-on: ${{ (vars.NO_SELF_HOSTED_RUNNERS || github.event.pull_request.head.repo.fork) && 'ubuntu-22.04' || 'servo-ohos-linux' }}
+    runs-on: ${{ (vars.NO_SELF_HOSTED_RUNNERS || github.event.pull_request && github.event.pull_request.head.repo.full_name != github.repository) && 'ubuntu-22.04' || 'servo-ohos-linux' }}
     steps:
       - uses: servo/ci-runners/actions/checkout@b42c96524cdd72126255602c69c4ad649c750ebf
       - name: Free Disk Space (Ubuntu)
