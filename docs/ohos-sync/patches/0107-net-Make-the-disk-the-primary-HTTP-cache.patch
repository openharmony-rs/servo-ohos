+    let store = open_disk_store(&path);
+    let on_disk: u64 = fs::read_dir(path.join("entries"))
+        .unwrap()
+        .flatten()
+        .map(|entry| entry.metadata().unwrap().len())
+        .sum();
+    assert_eq!(
+        store.disk_bytes(),
+        on_disk,
+        "the index written after the removal must only hold what is on disk"
