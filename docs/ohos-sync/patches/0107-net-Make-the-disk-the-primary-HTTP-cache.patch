+        Ok(())
+    }
+}
+
+/// Everything a store and its in-flight writers share.
+struct StoreCore {
+    dir: PathBuf,
+    entries_dir: PathBuf,
+    /// Where bodies are written until they are committed. Emptied on open.
+    tmp_dir: PathBuf,
