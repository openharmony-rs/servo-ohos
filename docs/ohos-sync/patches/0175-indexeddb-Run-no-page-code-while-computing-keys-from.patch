-      if (this.hole !== true) {
-        return undefined;
-      }
-      for (const request of requests) {
-        try {
-          request();
-          names += ' none';
-        } catch (e) {
-          names += ' ' + e.name;
-        }
-      }
-      return undefined;
+      calls.count++;
+      return value;
     },
-    set(value) {
-      Object.defineProperty(this, 1, {value, writable: true, enumerable: true, configurable: true});
