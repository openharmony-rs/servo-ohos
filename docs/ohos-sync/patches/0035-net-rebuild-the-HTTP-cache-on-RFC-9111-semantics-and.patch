-/// Constructing Responses from Caches.
-/// <https://tools.ietf.org/html/rfc7234#section-4>
-pub(crate) fn construct_response(
-    request: &Request,
-    done_chan: &mut DoneChannel,
-    cache_result: &[CachedResource],
