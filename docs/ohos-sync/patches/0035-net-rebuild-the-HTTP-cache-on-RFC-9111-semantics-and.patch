-    let mut complete_cached_resources = candidates
-        .iter()
-        .filter(|resource| resource.status == StatusCode::OK);
-    let partial_cached_resources = candidates
-        .iter()
-        .filter(|resource| resource.status == StatusCode::PARTIAL_CONTENT);
