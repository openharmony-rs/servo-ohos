-        let original_request_headers = cached_resource.request_headers.lock();
-        if let Some(vary_value) = cached_headers.typed_get::<Vary>() {
-            if vary_value.is_any() {
-                debug!("vary value is any, not caching");
-                can_be_constructed = false
