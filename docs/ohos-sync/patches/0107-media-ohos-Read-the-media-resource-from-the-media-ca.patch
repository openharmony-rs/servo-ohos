+    fn read(&self, pos: i64, dest: &mut [u8]) -> i32 {
+        let deadline = Instant::now() + MAX_READ_WAIT;
+        loop {
+            // Counting the wakes before reading makes sure that a wake right after a pending read
+            // is not lost.
+            let wakes = self.wake.wakes();
