diff --git a/tests/wpt/mozilla/tests/mozilla/navigation-timing-network-error.html b/tests/wpt/mozilla/tests/mozilla/navigation-timing-network-error.html
new file mode 100644
index 00000000000..fc4e9df1d63
--- /dev/null
+++ b/tests/wpt/mozilla/tests/mozilla/navigation-timing-network-error.html
@@ -0,0 +1,21 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Navigation timing of a document whose body ends with a network error</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+promise_test(async t => {
+  const iframe = document.createElement("iframe");
+  const loaded = new Promise(resolve => iframe.onload = resolve);
+  iframe.src = "resources/document-network-error.py";
+  document.body.append(iframe);
+  t.add_cleanup(() => iframe.remove());
+  await loaded;
+  assert_equals(iframe.contentDocument.body.textContent, "cut short", "content");
+  const [entry] = iframe.contentWindow.performance.getEntriesByType("navigation");
+  assert_greater_than(entry.fetchStart, 0, "fetchStart");
+  assert_greater_than_equal(entry.requestStart, entry.fetchStart, "requestStart");
+  assert_greater_than(entry.responseEnd, entry.requestStart, "responseEnd");
+}, "A document whose body is cut short keeps the timing of its fetch");
+</script>
diff --git a/tests/wpt/mozilla/tests/mozilla/resources/document-network-error.py b/tests/wpt/mozilla/tests/mozilla/resources/document-network-error.py
new file mode 100644
index 00000000000..b2432174a29
--- /dev/null
+++ b/tests/wpt/mozilla/tests/mozilla/resources/document-network-error.py
@@ -0,0 +1,17 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+document = b"<!doctype html><p>cut short"
+
+
+def main(request, response):
+    response.add_required_headers = False
+    output = b"HTTP/1.1 200 OK\r\n"
+    output += b"Content-Type: text/html\r\n"
+    output += b"Connection: close\r\n"
+    output += b"Content-Length: %d\r\n" % (len(document) + 8)
+    output += b"\r\n"
+    output += document
+    response.writer.write(output)
+    response.close_connection = True
