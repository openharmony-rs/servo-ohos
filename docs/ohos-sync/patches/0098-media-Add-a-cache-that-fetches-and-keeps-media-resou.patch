+        2 * BLOCK_SIZE,
+        0,
+    );
+    assert_eq!(server.state(0), FakeState::Running);
+    assert_eq!(events.lock().last(), Some(&ReaderEvent::DownloadResumed));
+    server.pump();
+    assert_eq!(server.state(0), FakeState::Suspended);
+    assert_eq!(server.requests().len(), 1);
