new file mode 100644
index 00000000000..fa28c24de77
--- /dev/null
+++ b/components/media/cache/store.rs
@@ -0,0 +1,224 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! The slots of the temporary file in which the cache keeps the blocks of large resources.
+
+use std::fs::File;
+use std::io;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use log::warn;
+
+use crate::resource::ResourceId;
+
+pub(crate) const BLOCK_SIZE: u64 = 64 * 1024;
+
+pub(crate) type SlotId = usize;
+
+/// The memory fallback keeps at least this many slots for blocks of resources that are not
+/// kept in memory, so that they can still play.
+const MIN_FALLBACK_SLOTS: usize = 16;
+
+enum FileState {
+    NotCreated,
+    Created(Arc<File>),
+    Failed,
+}
+
+/// Hands out the slots of the anonymous temporary file, one block each, up to the budget. If
+/// the file cannot be created or written, the slots are only an account of a RAM budget, and
+/// the blocks keep their data in memory.
+pub(crate) struct Store {
+    directory: Option<PathBuf>,
+    file: FileState,
+    /// Whether a read or write of the file failed, so that blocks stay in memory.
+    io_failed: bool,
+    file_slots: usize,
+    fallback_slots: usize,
+    /// The block that owns each slot. A slot that is released while it is pinned stays out of
+    /// `free` until it is unpinned.
+    owners: Vec<Option<(ResourceId, u64)>>,
+    /// The file I/O in progress on each slot.
+    pins: Vec<u32>,
+    free: Vec<SlotId>,
+    used: usize,
+    /// The slots' worth of memory that resources kept in memory may use, which the memory
+    /// fallback does not offer to other blocks.
+    reserved_slots: usize,
+}
+
+impl Store {
+    pub(crate) fn new(file_budget: u64, fallback_budget: u64, directory: Option<PathBuf>) -> Self {
+        Self {
+            directory,
+            file: FileState::NotCreated,
+            io_failed: false,
+            file_slots: (file_budget / BLOCK_SIZE).max(1) as usize,
+            fallback_slots: (fallback_budget / BLOCK_SIZE).max(1) as usize,
+            owners: Vec::new(),
+            pins: Vec::new(),
+            free: Vec::new(),
+            used: 0,
+            reserved_slots: 0,
+        }
+    }
+
+    /// Whether blocks stay in memory because the file cannot be used.
+    pub(crate) fn ram_mode(&self) -> bool {
+        matches!(self.file, FileState::Failed) || self.io_failed
+    }
+
+    pub(crate) fn capacity(&self) -> usize {
+        if self.ram_mode() {
+            self.fallback_slots
+                .saturating_sub(self.reserved_slots)
+                .max(MIN_FALLBACK_SLOTS.min(self.fallback_slots))
+        } else {
+            self.file_slots
+        }
+    }
+
+    pub(crate) fn set_reserved(&mut self, bytes: u64) {
+        self.reserved_slots = bytes.div_ceil(BLOCK_SIZE) as usize;
+    }
+
+    pub(crate) fn used(&self) -> usize {
+        self.used
+    }
+
+    /// The file to read the slots from, if it exists.
+    pub(crate) fn file(&self) -> Option<Arc<File>> {
+        match &self.file {
+            FileState::Created(file) => Some(file.clone()),
+            _ => None,
+        }
+    }
+
+    /// The file to write blocks to, unless the cache keeps them in memory.
+    pub(crate) fn writable_file(&self) -> Option<Arc<File>> {
+        if self.io_failed {
+            return None;
+        }
+        self.file()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn file_created(&self) -> bool {
+        matches!(self.file, FileState::Created(_))
+    }
+
+    fn ensure_file(&mut self) {
+        if !matches!(self.file, FileState::NotCreated) {
+            return;
+        }
+        let file = match &self.directory {
+            Some(directory) => tempfile::tempfile_in(directory),
+            None => tempfile::tempfile(),
+        };
+        self.file = match file {
+            Ok(file) => FileState::Created(Arc::new(file)),
+            Err(error) => {
+                warn!(
+                    "Media cache: cannot create its temporary file ({error}); keeping at most {} MiB in memory instead",
+                    self.fallback_slots as u64 * BLOCK_SIZE / (1024 * 1024)
+                );
+                FileState::Failed
+            },
+        };
+    }
+
+    /// A read or write of the file failed: keep new blocks in memory from now on.
+    pub(crate) fn io_error(&mut self, error: io::Error) {
+        if !self.io_failed {
+            warn!("Media cache: cannot use its temporary file ({error}); keeping blocks in memory");
+            self.io_failed = true;
+        }
+    }
+
+    /// A free slot for a block, unless the budget is used up.
+    pub(crate) fn allocate(&mut self, owner: (ResourceId, u64)) -> Option<SlotId> {
+        self.ensure_file();
+        if self.used >= self.capacity() {
+            return None;
+        }
+        let slot = match self.free.pop() {
+            Some(slot) => slot,
+            None => {
+                self.owners.push(None);
+                self.pins.push(0);
+                self.owners.len() - 1
+            },
+        };
+        self.owners[slot] = Some(owner);
+        self.used += 1;
+        Some(slot)
+    }
+
+    pub(crate) fn release(&mut self, slot: SlotId) {
+        if self.owners[slot].take().is_some() {
+            self.used -= 1;
+            if self.pins[slot] == 0 {
+                self.free.push(slot);
+            }
+        }
+    }
+
+    pub(crate) fn pin(&mut self, slot: SlotId) {
+        self.pins[slot] += 1;
+    }
+
+    pub(crate) fn unpin(&mut self, slot: SlotId) {
+        self.pins[slot] -= 1;
+        if self.pins[slot] == 0 && self.owners[slot].is_none() {
+            self.free.push(slot);
+        }
+    }
+
+    pub(crate) fn pinned(&self, slot: SlotId) -> bool {
+        self.pins[slot] > 0
+    }
+}
+
+pub(crate) fn slot_offset(slot: SlotId) -> u64 {
+    slot as u64 * BLOCK_SIZE
+}
+
+#[cfg(unix)]
+pub(crate) fn write_at(file: &File, data: &[u8], offset: u64) -> io::Result<()> {
+    use std::os::unix::fs::FileExt;
+    file.write_all_at(data, offset)
+}
+
+#[cfg(unix)]
+pub(crate) fn read_at(file: &File, dest: &mut [u8], offset: u64) -> io::Result<()> {
+    use std::os::unix::fs::FileExt;
+    file.read_exact_at(dest, offset)
+}
+
+#[cfg(windows)]
+pub(crate) fn write_at(file: &File, data: &[u8], offset: u64) -> io::Result<()> {
+    use std::os::windows::fs::FileExt;
+    let mut done = 0;
+    while done < data.len() {
+        match file.seek_write(&data[done..], offset + done as u64)? {
+            0 => return Err(io::ErrorKind::WriteZero.into()),
+            written => done += written,
+        }
+    }
+    Ok(())
+}
+
+#[cfg(windows)]
+pub(crate) fn read_at(file: &File, dest: &mut [u8], offset: u64) -> io::Result<()> {
+    use std::os::windows::fs::FileExt;
+    let mut done = 0;
+    while done < dest.len() {
+        match file.seek_read(&mut dest[done..], offset + done as u64)? {
+            0 => return Err(io::ErrorKind::UnexpectedEof.into()),
+            read => done += read,
+        }
+    }
+    Ok(())
+}
diff --git a/components/media/cache/tests.rs b/components/media/cache/tests.rs
new file mode 100644
index 00000000000..3841c816f2b
--- /dev/null
+++ b/components/media/cache/tests.rs
@@ -0,0 +1,1970 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Weak};
+use std::time::Duration;
+
+use bytes::Bytes;
+use parking_lot::Mutex;
+
+use crate::cache::Settings;
+use crate::clock::FakeClock;
+use crate::store::BLOCK_SIZE;
+use crate::*;
+
+const MIB: u64 = 1024 * 1024;
+const KIB: u64 = 1024;
+
+fn pattern(seed: u64, pos: u64) -> u8 {
+    ((pos + seed) % 251) as u8
+}
+
+#[derive(Clone)]
+struct ServerConfig {
+    /// The bytes the server has.
+    length: u64,
+    /// The length it announces, `None` for an unknown length.
+    announced_length: Option<u64>,
+    ranges: bool,
+    seed: u64,
+    validator: Option<Validator>,
+    origin: Option<String>,
+    cors_tainted: bool,
+    /// Answers a range request after the start with a 206 from this much earlier, or later
+    /// if negative.
+    answer_shift: i64,
+    chunk: usize,
+    decline_suspend: bool,
+    /// Ends each fetch with a network error after this many bytes.
+    fail_after: Option<u64>,
+    /// Ends each fetch without an error after this many bytes.
+    close_after: Option<u64>,
+}
+
+impl ServerConfig {
+    fn new(length: u64) -> Self {
+        Self {
+            length,
+            announced_length: Some(length),
+            ranges: true,
+            seed: 0,
+            validator: Some(Validator::ETag("\"v1\"".into())),
+            origin: Some("https://example.com".into()),
+            cors_tainted: false,
+            answer_shift: 0,
+            chunk: 16 * KIB as usize,
+            decline_suspend: false,
+            fail_after: None,
+            close_after: None,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum FakeState {
+    Running,
+    Suspended,
+    Cancelled,
+    Ended,
+}
+
+struct FakeFetch {
+    request: FetchRequest,
+    sink: Arc<dyn FetchSink>,
+    config: ServerConfig,
+    state: FakeState,
+    responded: bool,
+    pos: u64,
+    sent: u64,
+    suspends: u32,
+    resumes: u32,
+}
+
+#[derive(Default)]
+struct FakeServer {
+    config: Mutex<Option<ServerConfig>>,
+    fetches: Mutex<Vec<FakeFetch>>,
+}
+
+enum Step {
+    Response(ResponseInfo),
+    Data(Bytes),
+    End(Result<(), FetchError>),
+}
+
+impl FakeServer {
+    fn new(config: ServerConfig) -> Arc<Self> {
+        let server = Arc::new(FakeServer::default());
+        server.set_config(config);
+        server
+    }
+
+    fn set_config(&self, config: ServerConfig) {
+        *self.config.lock() = Some(config);
+    }
+
+    fn update_config(&self, change: impl FnOnce(&mut ServerConfig)) {
+        change(self.config.lock().as_mut().unwrap());
+    }
+
+    fn fetcher(self: &Arc<Self>) -> Arc<dyn Fetcher> {
+        Arc::new(FakeFetcher(self.clone()))
+    }
+
+    fn requests(&self) -> Vec<FetchRequest> {
+        self.fetches
+            .lock()
+            .iter()
+            .map(|fetch| fetch.request.clone())
+            .collect()
+    }
+
+    fn state(&self, index: usize) -> FakeState {
+        self.fetches.lock()[index].state
+    }
+
+    fn suspends(&self, index: usize) -> u32 {
+        self.fetches.lock()[index].suspends
+    }
+
+    fn resumes(&self, index: usize) -> u32 {
+        self.fetches.lock()[index].resumes
+    }
+
+    fn sent(&self, index: usize) -> u64 {
+        self.fetches.lock()[index].sent
+    }
+
+    /// Makes one running fetch take one step. Calls the sink without the server's lock, as
+    /// the sink may call back into the handle.
+    fn step(&self) -> bool {
+        self.step_matching(|_| true)
+    }
+
+    fn step_matching(&self, matches: impl Fn(usize) -> bool) -> bool {
+        let (sink, step) = {
+            let mut fetches = self.fetches.lock();
+            let Some((_, fetch)) = fetches
+                .iter_mut()
+                .enumerate()
+                .find(|(index, fetch)| fetch.state == FakeState::Running && matches(*index))
+            else {
+                return false;
+            };
+            let config = fetch.config.clone();
+            let step = if !fetch.responded {
+                fetch.responded = true;
+                let start = fetch.request.start;
+                if config.ranges &&
+                    config
+                        .announced_length
+                        .is_some_and(|length| start >= length) ||
+                    config.ranges && start >= config.length && start > 0
+                {
+                    fetch.state = FakeState::Ended;
+                    Step::End(Err(FetchError::RangeNotSatisfiable))
+                } else {
+                    fetch.pos = match config.ranges {
+                        true if start > 0 => start.saturating_add_signed(-config.answer_shift),
+                        true => start,
+                        false => 0,
+                    };
+                    Step::Response(ResponseInfo {
+                        partial: config.ranges,
+                        start: fetch.pos,
+                        total_length: config.announced_length,
+                        validator: config.validator.clone(),
+                        encoded: false,
+                        cors_tainted: config.cors_tainted,
+                        origin: config.origin.clone(),
+                    })
+                }
+            } else if config.fail_after.is_some_and(|limit| fetch.sent >= limit) {
+                fetch.state = FakeState::Ended;
+                Step::End(Err(FetchError::Network))
+            } else if fetch.pos >= config.length ||
+                config.close_after.is_some_and(|limit| fetch.sent >= limit)
+            {
+                fetch.state = FakeState::Ended;
+                Step::End(Ok(()))
+            } else {
+                let mut count = (config.chunk as u64).min(config.length - fetch.pos);
+                for limit in [config.fail_after, config.close_after]
+                    .into_iter()
+                    .flatten()
+                {
+                    count = count.min(limit - fetch.sent);
+                }
+                let data: Vec<u8> = (fetch.pos..fetch.pos + count)
+                    .map(|pos| pattern(config.seed, pos))
+                    .collect();
+                fetch.pos += count;
+                fetch.sent += count;
+                Step::Data(Bytes::from(data))
+            };
+            (fetch.sink.clone(), step)
+        };
+        match step {
+            Step::Response(info) => sink.response(info),
+            Step::Data(data) => sink.data(data),
+            Step::End(result) => sink.end(result),
+        }
+        true
+    }
+
+    /// Makes fetch `index` take one step, if it is running.
+    fn step_fetch(&self, index: usize) -> bool {
+        self.step_matching(|other| other == index)
+    }
+
+    /// Runs the fetches until all are suspended, cancelled or done.
+    fn pump(&self) {
+        let mut steps = 0;
+        while self.step() {
+            steps += 1;
+            assert!(steps < 100_000, "the fetches never stop");
+        }
+    }
+}
+
+struct FakeFetcher(Arc<FakeServer>);
+
+impl Fetcher for FakeFetcher {
+    fn start(&self, request: FetchRequest, sink: Arc<dyn FetchSink>) -> Box<dyn FetchHandle> {
+        let config = self.0.config.lock().clone().unwrap();
+        let mut fetches = self.0.fetches.lock();
+        fetches.push(FakeFetch {
+            request,
+            sink,
+            config,
+            state: FakeState::Running,
+            responded: false,
+            pos: 0,
+            sent: 0,
+            suspends: 0,
+            resumes: 0,
+        });
+        Box::new(FakeHandle {
+            server: self.0.clone(),
+            index: fetches.len() - 1,
+        })
+    }
+}
+
+struct FakeHandle {
+    server: Arc<FakeServer>,
+    index: usize,
+}
+
+impl FetchHandle for FakeHandle {
+    fn suspend(&self) {
+        let (sink, honoured) = {
+            let mut fetches = self.server.fetches.lock();
+            let fetch = &mut fetches[self.index];
+            fetch.suspends += 1;
+            let honoured = !fetch.config.decline_suspend && fetch.state == FakeState::Running;
+            if honoured {
+                fetch.state = FakeState::Suspended;
+            }
+            (fetch.sink.clone(), honoured)
+        };
+        sink.suspended(honoured);
+    }
+
+    fn resume(&self) {
+        let mut fetches = self.server.fetches.lock();
+        let fetch = &mut fetches[self.index];
+        fetch.resumes += 1;
+        if fetch.state == FakeState::Suspended {
+            fetch.state = FakeState::Running;
+        }
+    }
+
+    fn cancel(&self) {
+        let mut fetches = self.server.fetches.lock();
+        let fetch = &mut fetches[self.index];
+        if matches!(fetch.state, FakeState::Running | FakeState::Suspended) {
+            fetch.state = FakeState::Cancelled;
+        }
+    }
+}
+
+impl Drop for FakeHandle {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+fn settings() -> Settings {
+    Settings {
+        file_budget: 64 * MIB,
+        memory_resource_limit: 8 * MIB,
+        memory_fallback: 32 * MIB,
+        readahead: Duration::from_secs(30),
+        resume: Duration::from_secs(10),
+        suspend_timeout: Duration::from_secs(30),
+        reuse: Duration::from_secs(300),
+        directory: None,
+    }
+}
+
+fn key(name: &str) -> ResourceKey {
+    ResourceKey {
+        url: format!("https://example.com/{name}"),
+        cors_mode: CorsMode::NoCors,
+        origin: "https://example.com".into(),
+    }
+}
+
+struct Setup {
+    clock: Arc<FakeClock>,
+    cache: MediaCache,
+    _directory: tempfile::TempDir,
+}
+
+fn setup(mut settings: Settings) -> Setup {
+    let clock = Arc::new(FakeClock::default());
+    let directory = tempfile::tempdir().unwrap();
+    settings
+        .directory
+        .get_or_insert_with(|| directory.path().to_owned());
+    let cache = MediaCache::with_clock(settings, clock.clone());
+    Setup {
+        clock,
+        cache,
+        _directory: directory,
+    }
+}
+
+impl Setup {
+    fn advance(&self, seconds: u64) {
+        self.clock.advance(Duration::from_secs(seconds));
+    }
+
+    fn with_resource<R>(
+        &self,
+        key: &ResourceKey,
+        f: impl FnOnce(&crate::resource::Resource) -> R,
+    ) -> R {
+        let state = self.cache.inner.state.lock();
+        f(state.resource(key).expect("resource exists"))
+    }
+
+    fn block_indices(&self, key: &ResourceKey) -> Vec<u64> {
+        self.with_resource(key, |res| res.blocks.keys().copied().collect())
+    }
+}
+
+/// Reads `len` bytes at `pos`, pumping the server while the data is pending, and checks them.
+fn read_expect(server: &FakeServer, reader: &MediaReader, pos: u64, len: u64, seed: u64) {
+    let mut buffer = vec![0; 100 * KIB as usize];
+    let mut at = pos;
+    let mut steps = 0;
+    while at < pos + len {
+        steps += 1;
+        assert!(steps < 100_000, "no progress at {at}");
+        let want = ((pos + len - at) as usize).min(buffer.len());
+        match reader.read_at(at, &mut buffer[..want]) {
+            ReadResult::Data(count) => {
+                for (offset, byte) in buffer[..count].iter().enumerate() {
+                    assert_eq!(
+                        *byte,
+                        pattern(seed, at + offset as u64),
+                        "byte at {}",
+                        at + offset as u64
+                    );
+                }
+                at += count as u64;
+            },
+            ReadResult::Pending => assert!(server.step(), "pending at {at} with nothing to fetch"),
+            other => panic!("read at {at}: {other:?}"),
+        }
+    }
+}
+
+/// Reads at `pos`, stepping the server while the read is pending, at most `steps` times.
+fn read_settled(server: &FakeServer, reader: &MediaReader, pos: u64, steps: usize) -> ReadResult {
+    for _ in 0..steps {
+        match read_once(reader, pos) {
+            ReadResult::Pending => {
+                if !server.step() {
+                    return ReadResult::Pending;
+                }
+            },
+            other => return other,
+        }
+    }
+    ReadResult::Pending
+}
+
+fn read_once(reader: &MediaReader, pos: u64) -> ReadResult {
+    let mut buffer = vec![0; 4096];
+    reader.read_at(pos, &mut buffer)
+}
+
+fn events(reader: &MediaReader) -> Arc<Mutex<Vec<ReaderEvent>>> {
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let sink = events.clone();
+    reader.set_observer(Box::new(move |event| sink.lock().push(event)));
+    events
+}
+
+#[test]
+fn sequential_read() {
+    let setup = setup(settings());
+    let server = FakeServer::new(ServerConfig::new(20 * MIB));
+    let reader = setup.cache.open(key("a"), server.fetcher());
+    let events = events(&reader);
+    read_expect(&server, &reader, 0, 20 * MIB, 0);
+    server.pump();
+    assert_eq!(read_once(&reader, 20 * MIB), ReadResult::EndOfStream);
+    let requests = server.requests();
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0].start, 0);
+    assert_eq!(requests[0].if_range, None);
+    assert_eq!(reader.length(), Some(20 * MIB));
+    assert!(reader.seekable());
+    let events = events.lock();
+    assert_eq!(
+        events[0],
+        ReaderEvent::Metadata {
+            length: Some(20 * MIB),
+            seekable: true,
+            cors_tainted: false
+        }
+    );
+    assert!(events.contains(&ReaderEvent::Progress));
+    assert_eq!(events.last(), Some(&ReaderEvent::Complete));
+}
