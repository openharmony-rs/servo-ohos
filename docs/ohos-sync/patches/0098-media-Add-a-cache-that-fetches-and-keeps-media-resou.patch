+    read_expect(&server, &first, 0, 3 * MIB, 0);
+    read_expect(&server, &second, 0, 12 * MIB, 0);
+    read_expect(&server, &first, 3 * MIB, 9 * MIB, 0);
+    assert_eq!(server.requests().len(), 1);
