From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Schwender <schwenderjonathan@gmail.com>
Date: Sat, 17 Oct 2026 16:54:05 +0000
Subject: [PATCH] script: Keep the media reader state of a media element on the
 heap

The state of the reader of the media cache, with that of the push
adapter and the stall timer, made every media element larger, also the
many that never load a resource. Keep it in a Box, which takes
HTMLVideoElement from 1224 to 1136 bytes.

Fork note: meant for upstream. Drop once upstream has it.

Testing: `./mach test-unit size_of`.

Validation: `./mach test-unit size_of` passes.

AI-assisted: Yes (agent session; implemented by the agent)
Signed-off-by: Jonathan Schwender <schwenderjonathan@gmail.com>
---
 .../script/dom/html/embedded_content/htmlmediaelement.rs  | 8 ++++----
 tests/unit/script/size_of.rs                              | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/components/script/dom/html/embedded_content/htmlmediaelement.rs b/components/script/dom/html/embedded_content/htmlmediaelement.rs
index 62ab7c8e2dc..de446b78657 100644
--- a/components/script/dom/html/embedded_content/htmlmediaelement.rs
+++ b/components/script/dom/html/embedded_content/htmlmediaelement.rs
@@ -293,9 +293,9 @@ pub(crate) struct HTMLMediaElement {
     #[ignore_malloc_size_of = "Defined in std::time"]
     next_timeupdate_event: Cell<Instant>,
     /// The reader of the media resource in the media cache, if the element reads one.
-    #[ignore_malloc_size_of = "The media cache measures the media data"]
+    #[ignore_malloc_size_of = "The media data is in the media cache, which is not reported yet"]
     #[no_trace]
-    media_reader: RefCell<Option<MediaResourceReader>>,
+    media_reader: DomRefCell<Option<Box<MediaResourceReader>>>,
     /// Identifies the reader that the element opened last.
     last_reader_id: Cell<u32>,
     /// Whether the media data is CORS-same-origin. Once a response for the current media resource
@@ -1691,7 +1691,7 @@ impl HTMLMediaElement {
             }));
         }
 
-        *self.media_reader.borrow_mut() = Some(MediaResourceReader {
+        *self.media_reader.borrow_mut() = Some(Box::new(MediaResourceReader {
             reader,
             id,
             push: (!pulls).then(PushAdapter::default),
@@ -1701,7 +1701,7 @@ impl HTMLMediaElement {
             last_progress: Instant::now(),
             stall_check_pending: false,
             stalled: false,
-        });
+        }));
         self.origin_clean.set(true);
         document.register_media_element_with_reader(self);
         self.update_reader_activity();
diff --git a/tests/unit/script/size_of.rs b/tests/unit/script/size_of.rs
index 7401cfecb2f..2f19d7b74ad 100644
--- a/tests/unit/script/size_of.rs
+++ b/tests/unit/script/size_of.rs
@@ -37,7 +37,7 @@ sizeof_checker!(size_div, HTMLDivElement, 344);
 sizeof_checker!(size_span, HTMLSpanElement, 344);
 sizeof_checker!(size_htmlscript, HTMLScriptElement, 488);
 sizeof_checker!(size_htmlimage, HTMLImageElement, 576);
-sizeof_checker!(size_htmlvideo, HTMLVideoElement, 1200);
+sizeof_checker!(size_htmlvideo, HTMLVideoElement, 1136);
 sizeof_checker!(size_text, Text, 168);
 sizeof_checker!(size_characterdata, CharacterData, 168);
 sizeof_checker!(size_contentattributedata, ContentAttributeData, 72);
