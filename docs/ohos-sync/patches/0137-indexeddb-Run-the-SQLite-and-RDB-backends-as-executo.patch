-                match request.operation {
-                    AsyncOperation::ReadWrite(AsyncReadWriteOperation::PutItem {
-                        callback,
-                        key,
-                        value,
-                        should_overwrite,
-                        key_generator_current_number,
-                    }) => {
-                        let (key, key_generator_current_number) = match key {
-                            Some(key) => (key, key_generator_current_number),
