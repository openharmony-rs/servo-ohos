-            Expr::column(object_data_model::Column::Key).lt(upper_bytes)
-        } else {
-            Expr::column(object_data_model::Column::Key).lte(upper_bytes)
-        };
-        parts.push(query);
-    }
-    if let Some(lower) = range.lower.as_ref() {
-        let lower_bytes = encoding::serialize(lower);
