-fn get_db_status(connection: &Connection, op: i32) -> Result<i32, i32> {
-    let mut p_curr = 0;
-    let mut p_hiwater = 0;
-    let res = unsafe {
-        rusqlite::ffi::sqlite3_db_status(connection.handle(), op, &mut p_curr, &mut p_hiwater, 0)
-    };
-    if res != 0 { Err(res) } else { Ok(p_curr) }
-}
