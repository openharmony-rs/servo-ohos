+fn get_request(
+    callback: GenericCallback<BackendResult<Option<Vec<u8>>>>,
+    key: f64,
+) -> KvsOperation {
+    request(
+        "test_store",
+        AsyncOperation::ReadOnly(AsyncReadOnlyOperation::GetItem {
+            callback,
+            key_range: IndexedDBKeyRange::only(IndexedDBKeyType::Number(key)),
+        }),
+    )
+}
