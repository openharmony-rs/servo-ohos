         self.handle_new_or_removed_web_fonts_post_reflow(cx, reflow_result.changed_web_fonts);
 
         self.handle_pending_images_post_reflow(
diff --git a/components/script/event_loop/document_loader.rs b/components/script/event_loop/document_loader.rs
index a07b59f7e49..f00b20d99a4 100644
--- a/components/script/event_loop/document_loader.rs
+++ b/components/script/event_loop/document_loader.rs
@@ -24,6 +24,8 @@ pub(crate) enum LoadType {
     Stylesheet(#[no_trace] ServoUrl),
     PageSource(#[no_trace] ServoUrl),
     Media,
+    /// Web fonts that layout found the page to need.
+    WebFonts,
 }
 
 /// Canary value ensuring that manually added blocking loads are always removed by the
diff --git a/components/script/event_loop/script_thread.rs b/components/script/event_loop/script_thread.rs
index d17138fedb3..5ad755ddb7d 100644
--- a/components/script/event_loop/script_thread.rs
+++ b/components/script/event_loop/script_thread.rs
@@ -1327,6 +1327,7 @@ impl ScriptThread {
     fn maybe_fulfill_font_ready_promises(&self, cx: &mut js::context::JSContext) {
         let mut sent_message = false;
         for (_, document) in self.documents.borrow().iter() {
+            document.maybe_stop_delaying_load_event_for_web_fonts(cx);
             sent_message = document.maybe_fulfill_font_ready_promise(cx) || sent_message;
         }
 
