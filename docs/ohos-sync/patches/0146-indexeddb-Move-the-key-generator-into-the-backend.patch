+    let replies = run_puts(&db, 2, "test_store", vec![(None, vec![4])], true);
+    assert_eq!(replies[0], key_reply(1.0));
+    assert_eq!(commit(&db, 2), Ok(()));
+    assert_eq!(db.key_generator_current_number("test_store"), Some(2));
+}
