diff --git a/tests/wpt/tests/html/canvas/element/manual/drawing-images-to-the-canvas/drawimage_video_crossorigin_seek.sub.html b/tests/wpt/tests/html/canvas/element/manual/drawing-images-to-the-canvas/drawimage_video_crossorigin_seek.sub.html
new file mode 100644
index 00000000000..da87c2916ef
--- /dev/null
+++ b/tests/wpt/tests/html/canvas/element/manual/drawing-images-to-the-canvas/drawimage_video_crossorigin_seek.sub.html
@@ -0,0 +1,44 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<title>A video from another origin taints the canvas while it seeks</title>
+<link rel="help" href="https://html.spec.whatwg.org/multipage/#the-image-argument-is-not-origin-clean">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script src="/common/media.js"></script>
+<body>
+<script>
+  function assert_taints(video, description) {
+    const context = document.createElement("canvas").getContext("2d");
+    context.drawImage(video, 0, 0);
+    assert_throws_dom("SecurityError", () => context.getImageData(0, 0, 1, 1), description);
+  }
+
+  promise_test(async t => {
+    const video = document.createElement("video");
+    video.muted = true;
+    // With preload=metadata, a seek fetches the media data that it needs, rather than finding it
+    // in a download of the whole resource.
+    video.preload = "metadata";
+    video.src = "http://{{hosts[][www]}}:{{ports[http][0]}}/html/canvas/element/manual/" +
+      "drawing-images-to-the-canvas/resources/delayed-range.py?name=" + getVideoURI("counting");
+    document.body.appendChild(video);
+    t.add_cleanup(() => video.remove());
+
+    await video.play();
+    video.pause();
+    assert_taints(video, "before seeking");
+
+    const seeked = new Promise(resolve => video.addEventListener("seeked", resolve));
+    let seeking = true;
+    seeked.then(() => seeking = false);
+    // The server delays its answer to a request for the media data at the new position.
+    video.currentTime = 5;
+    while (seeking) {
+      if (video.readyState >= video.HAVE_CURRENT_DATA) {
+        assert_taints(video, "while seeking");
+      }
+      await new Promise(resolve => t.step_timeout(resolve, 100));
+    }
+    assert_taints(video, "after seeking");
+  }, "Can't get pixels of a canvas with a non-CORS cross-origin video drawn while it seeks");
+</script>
diff --git a/tests/wpt/tests/html/canvas/element/manual/drawing-images-to-the-canvas/resources/delayed-range.py b/tests/wpt/tests/html/canvas/element/manual/drawing-images-to-the-canvas/resources/delayed-range.py
new file mode 100644
index 00000000000..73c910f1f33
--- /dev/null
+++ b/tests/wpt/tests/html/canvas/element/manual/drawing-images-to-the-canvas/resources/delayed-range.py
@@ -0,0 +1,26 @@
+import os
+import re
+import time
+
+
+def main(request, response):
+    name = os.path.basename(request.GET.first(b"name").decode())
+    with open(os.path.join(request.doc_root, "media", name), "rb") as f:
+        data = f.read()
+
+    headers = [
+        (b"Content-Type", b"video/" + name.rsplit(".", 1)[1].encode()),
+        (b"Accept-Ranges", b"bytes"),
+    ]
+
+    range_header = request.headers.get(b"range")
+    if not range_header:
+        return 200, headers, data
+
+    start = int(re.match(r"bytes=(\d*)-", range_header.decode()).group(1) or 0)
+    if start > 0:
+        # Delay the answer to a request in the middle of the resource, like the one that a seek
+        # makes, so that the media element waits for the headers of the response for a while.
+        time.sleep(float(request.GET.first(b"delay", b"2")))
+    headers.append((b"Content-Range", f"bytes {start}-{len(data) - 1}/{len(data)}".encode()))
+    return 206, headers, data[start:]
