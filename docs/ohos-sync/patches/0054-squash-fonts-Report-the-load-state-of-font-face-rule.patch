--- /dev/null
+++ b/tests/wpt/meta/css/css-fonts/font-variant-emoji-2.html.ini
@@ -0,0 +1,2 @@
+[font-variant-emoji-2.html]
+  expected: FAIL
diff --git a/tests/wpt/meta/css/css-fonts/matching/font-unicode-presented-as-emoji-outline.html.ini b/tests/wpt/meta/css/css-fonts/matching/font-unicode-presented-as-emoji-outline.html.ini
new file mode 100644
