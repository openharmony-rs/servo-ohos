+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jonathan Schwender <schwenderjonathan@gmail.com>
+Date: Sun, 2 Aug 2026 19:58:03 +0200
+Subject: [PATCH] config: Enable mmap based unix backend if available.
+
+The default backend uses `fread`, which showed up heavily in some
+perf graphs in servo.
+The upstream build-system selects the unix backend with mmap support
+if possible (after probing), so we emulate that in build.rs by checking
+if mmap is available.
+---
+ build.rs | 85 ++++++++++++++++++++++++++++++++++++++++++++++++--------
+ 1 file changed, 74 insertions(+), 11 deletions(-)
+
+diff --git a/build.rs b/build.rs
+index 04f00c6..06f9773 100644
+--- a/build.rs
++++ b/build.rs
+@@ -1,8 +1,11 @@
+-use std::env;
+ use std::env::VarError;
++use std::{
++    env, fs,
++    path::{Path, PathBuf},
++};
+ 
+ fn add_sources(build: &mut cc::Build, root: &str, files: &[&str]) {
+-    let root = std::path::Path::new(root);
++    let root = Path::new(root);
+     build.files(files.iter().map(|src| {
+         let mut p = root.join(src);
