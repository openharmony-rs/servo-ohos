From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Schwender <schwenderjonathan@gmail.com>
Date: Wed, 4 Nov 2026 09:57:25 +0000
Subject: [PATCH] script: Run debugger.js on QuickJS

servo-quickjs now emulates SpiderMonkey's Debugger API, so the debugger
global defines it and runs debugger.js on QuickJS too. Before, console
evaluations, autocompletion and source lists of the QuickJS build waited
forever for debugger.js to reply. While paused, each devtools message
releases what it kept alive in QuickJS's autorelease pool.

The servo-quickjs pin moves from ae9eb96, where JS_DefineDebuggerObject
is a stub that panics, to 6ac4a17, which has the emulation. servo-quickjs
builds it, and QuickJS's patches for debuggers, only when asked, and
Servo can't enable a feature of it that SpiderMonkey's mozjs doesn't
have. So mach sets SERVO_QUICKJS_DEBUGGER=1 for QuickJS builds that may
have the devtools feature, and 0 for those without default features
that select no feature enabling it, which get none of the debugger code.
The QuickJS Cargo configuration defaults the variable to 1 for Cargo
commands run without mach.

Folded in "fixup! script: Run debugger.js on QuickJS":

mach decided whether a QuickJS build gets the shim's debugger from
servoshell's features that enable devtools, by their names on
ohos-main. On v0.6.0, devtools is no feature: it is always built, and
every script thread and worker creates the debugger global, which panics
in a shim built without its debugger. So a QuickJS build without default
features, mach's sanitizer builds among them, would have panicked at
startup. Every QuickJS build now sets SERVO_QUICKJS_DEBUGGER=1.

Validation: QuickJS builds against servo-quickjs 48bd1fc, the same tree as 6ac4a17 before it was merged: `./mach test-devtools` passes 102 tests with 7 expected failures in release and checked-release, the same tests as SpiderMonkey on this base (release build of the 2026-11-09 sync). A QuickJS release build without devtools (the default features but `default_tooling`, so `SERVO_QUICKJS_DEBUGGER=0`) has neither the emulation nor QuickJS's debugger code, and like the build with devtools runs a page with an external script (compiled off the main thread) and a dedicated worker. `may_have_devtools` gives 1 for the arguments of ohos-device-wpt.yml's QuickJS build (`--no-default-features --features "base ohos-rdb-backend"`) and for `-Fbase`, and 0 without default features and devtools; `[env]` in a Cargo configuration file sets the variable when the environment doesn't.
Validation: ("fixup! script: Run debugger.js on QuickJS") `./mach build --release --js-engine quickjs` of this stack ran WPT with the debugger enabled (the value it had there already); `ruff format --check` and `ruff check` pass on the file.
AI-assisted: Yes (agent session; written and tested by the agent, reviewed by another agent)
AI-assisted: Yes (agent session; "fixup! script: Run debugger.js on QuickJS": 2026-11-27 ohos-v0.6 sync -- found by an independent review; the agent removed the feature check)
AI-assisted: Yes (agent session; 2026-11-27 ohos-v0.6 sync -- folded in "fixup! script: Run debugger.js on QuickJS")
Signed-off-by: Jonathan Schwender <schwenderjonathan@gmail.com>
---
 components/script/dom/debugger/debuggerglobalscope.rs | 9 +--------
 components/script/event_loop/script_thread.rs         | 5 +++++
 python/servo/command_base.py                          | 6 ++++++
 support/quickjs/cargo-config.toml                     | 7 ++++++-
 4 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/components/script/dom/debugger/debuggerglobalscope.rs b/components/script/dom/debugger/debuggerglobalscope.rs
index 3b83eda433d..e1883dd7004 100644
--- a/components/script/dom/debugger/debuggerglobalscope.rs
+++ b/components/script/dom/debugger/debuggerglobalscope.rs
@@ -12,12 +12,10 @@ use dom_struct::dom_struct;
 use embedder_traits::ScriptToEmbedderChan;
 use embedder_traits::resources::{self, Resource};
 use js::context::JSContext;
-#[cfg(not(feature = "js-quickjs"))]
 use js::rust::wrappers2::JS_DefineDebuggerObject;
 use net_traits::ResourceThreads;
 use profile_traits::{mem, time};
 use script_bindings::interfaces::HasOrigin;
-#[cfg(not(feature = "js-quickjs"))]
 use script_bindings::reflector::DomObject;
 use servo_base::generic_channel::{GenericCallback, GenericSender, channel};
 use servo_base::id::{Index, PipelineId, PipelineNamespaceId};
@@ -88,7 +86,7 @@ impl DebuggerGlobalScope {
     ///   pipeline ids, and they may contain debuggees from more than one pipeline
     /// - in web worker threads, it should be set to the pipeline id of the page that created the thread, because
     ///   those threads can’t generate pipeline ids, and they only contain one debuggee from one pipeline
-    #[cfg_attr(not(feature = "js-quickjs"), expect(unsafe_code))]
+    #[expect(unsafe_code)]
     #[expect(clippy::too_many_arguments)]
     pub(crate) fn new(
         debugger_pipeline_id: PipelineId,
@@ -134,7 +132,6 @@ impl DebuggerGlobalScope {
         let mut realm = enter_auto_realm(cx, &*global);
         let mut realm = realm.current_realm();
         define_all_exposed_interfaces(&mut realm, global.upcast());
-        #[cfg(not(feature = "js-quickjs"))]
         assert!(unsafe {
             // Invariants: `obj` must be a handle to a JS global object.
             JS_DefineDebuggerObject(&mut realm, global.global_scope.reflector().get_jsobject())
@@ -152,10 +149,6 @@ impl DebuggerGlobalScope {
     }
 
     pub(crate) fn execute(&self, cx: &mut JSContext) {
-        // QuickJS has no Debugger API.
-        if cfg!(feature = "js-quickjs") {
-            return;
-        }
         let mut realm = enter_auto_realm(cx, self);
         let cx = &mut realm.current_realm();
 
diff --git a/components/script/event_loop/script_thread.rs b/components/script/event_loop/script_thread.rs
index 63a2e1ad5e7..aaa93f5305c 100644
--- a/components/script/event_loop/script_thread.rs
+++ b/components/script/event_loop/script_thread.rs
@@ -2287,6 +2287,11 @@ impl ScriptThread {
         let mut cx = unsafe { js::context::JSContext::from_ptr(js::rust::Runtime::get().unwrap()) };
 
         while self.debugger_paused.get() {
+            // QuickJS: release what each message kept alive in the autorelease pool, instead of
+            // when the paused task ends.
+            #[cfg(feature = "js-quickjs")]
+            #[allow(unsafe_code)]
+            let _pool_scope = unsafe { js::quickjs::AutoreleasePoolScope::new() };
             match self.receivers.devtools_server_receiver.recv() {
                 Ok(Ok(msg)) => self.handle_msg_from_devtools(msg, &mut cx),
                 _ => {
diff --git a/python/servo/command_base.py b/python/servo/command_base.py
index 58135212d83..af4892bc25c 100644
--- a/python/servo/command_base.py
+++ b/python/servo/command_base.py
@@ -859,6 +859,12 @@ class CommandBase(object):
                 features.append("js_backtrace")
             args += ["--features", " ".join(features)]
 
+        if self.js_engine == "quickjs":
+            # servo-quickjs builds its debugger, which devtools need, only when asked: Servo can't
+            # enable a feature of it that SpiderMonkey's mozjs doesn't have. Servo v0.6 always builds
+            # devtools and creates the debugger global, so every QuickJS build asks for it.
+            env["SERVO_QUICKJS_DEBUGGER"] = "1"
+
         if with_debug_assertions or self.config["build"]["debug-assertions"]:
             env["RUSTFLAGS"] = env.get("RUSTFLAGS", "") + " -C debug_assertions"
 
diff --git a/support/quickjs/cargo-config.toml b/support/quickjs/cargo-config.toml
index 2e4a987cb79..a339f1e8dbf 100644
--- a/support/quickjs/cargo-config.toml
+++ b/support/quickjs/cargo-config.toml
@@ -4,5 +4,10 @@
 # Bump the commit with mozjs at each sync, so that older commits keep building with the shim they
 # were tested with. The shim's version must match the mozjs version that Cargo.toml requires, or
 # Cargo leaves the patch unused.
+# servo-quickjs builds its debugger, which devtools need, only when asked. mach sets the variable
+# for each build, after the features; this default covers Cargo commands run without mach.
+[env]
+SERVO_QUICKJS_DEBUGGER = "1"
+
 [patch.crates-io]
-mozjs = { git = "https://github.com/openharmony-rs/servo-quickjs", rev = "ae9eb96c65821a35d51e20c6e1e24e7479fc2fb1" }
+mozjs = { git = "https://github.com/openharmony-rs/servo-quickjs", rev = "6ac4a17b197264851600edb124c7ef2b508c8f90" }
