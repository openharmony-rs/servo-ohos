From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Schwender <schwenderjonathan@gmail.com>
Date: Tue, 22 Sep 2026 19:50:38 +0000
Subject: [PATCH] fonts: Load the first available web font of elements without
 text

A web font is now only fetched once font matching picks it for a character,
so an element whose font-family names a web font but that has no text never
asked for it. The first available font is needed without text too, for
instance for `line-height: normal` and font-relative lengths, and Chrome and
Firefox load it: content-security-policy/font-src/font-stylesheet-font-blocked.sub.html
styles a body without text, preload/preload-resource-match.https.html an
empty paragraph, and both expect the font to be fetched.

After an element is restyled, layout now asks for the first available font of
its style to be loaded if it is a web font that has not been fetched. Only
elements whose font differs from their parent's are looked at, nothing is done
while the document has no web fonts, and the lookup runs once per font group.
It does not create fonts, so system fonts are not loaded for elements that
never draw text.

Fork note: fixes a regression from "fonts: Only load @font-face fonts that the
page uses"; fold into it at the next sync.

Testing: font-stylesheet-font-blocked.sub.html and preload-resource-match.https.html
pass again.

Validation: `./mach test-wpt --release css/css-fonts css/css-font-loading css/css-flexbox css/css-grid css/cssom-view css/css-inline css/css-text html/canvas/element/text html/canvas/offscreen/text content-security-policy/font-src preload svg` (8650 tests): no new unexpected results (besides font-variant-emoji-1 FAIL, which also happens on plain ohos-main, and the known intermittent grid-self-alignment-fit-content-001, only the css-inline initial-letter and text-box-trim directories, which include.ini skips and only ran because the parent directory was named). Host release build, keai page served locally over HTTP/1.1 keep-alive (2 runs each): still 66 font files fetched, anonymous memory 286 MiB with and without this patch.
AI-assisted: Yes (agent session; root-caused from the servo-ohos PR 12 try run and written by the agent)
Signed-off-by: Jonathan Schwender <schwenderjonathan@gmail.com>
---
 components/fonts/font.rs         | 37 ++++++++++++++++++++++++++++++++
 components/fonts/font_context.rs | 10 +++++++++
 components/layout/traversal.rs   | 26 ++++++++++++++++++++++
 3 files changed, 73 insertions(+)

diff --git a/components/fonts/font.rs b/components/fonts/font.rs
index f155191f52b..7d3dc17bdbc 100644
--- a/components/fonts/font.rs
+++ b/components/fonts/font.rs
@@ -6,6 +6,7 @@ use std::borrow::ToOwned;
 use std::collections::HashMap;
 use std::hash::Hash;
 use std::ops::Deref;
+use std::sync::atomic::{AtomicBool, Ordering};
 use std::sync::{Arc, OnceLock};
 use std::{iter, str};
 
@@ -780,6 +781,8 @@ pub struct FontGroup {
     /// It's unclear if this is the right thing to do. Perhaps fallbacks should
     /// always be stored here as it's quite likely that they will be used again.
     fallbacks: RwLock<HashMap<FallbackKey, FontRef>>,
+    /// Whether [`FontGroup::request_first_available_web_font`] has already run.
+    requested_first_available_web_font: AtomicBool,
 }
 
 impl FontGroup {
@@ -795,6 +798,40 @@ impl FontGroup {
             descriptor,
             families,
             fallbacks: Default::default(),
+            requested_first_available_web_font: Default::default(),
+        }
+    }
+
+    /// Ask for the first available font of this group to be loaded if it is a web font
+    /// that has not been fetched yet. Unlike [`FontGroup::first`], this does not need any
+    /// text and does not create fonts, so that it can be done for every element: the first
+    /// available font determines `line-height: normal` and font-relative lengths even for
+    /// elements without text.
+    pub fn request_first_available_web_font(&self, font_context: &FontContext) {
+        if self
+            .requested_first_available_web_font
+            .swap(true, Ordering::Relaxed)
+        {
+            return;
+        }
+
+        for template in self
+            .families
+            .iter()
+            .flat_map(|family| family.templates(font_context, &self.descriptor))
+            .filter(|template| template.template.char_in_unicode_range(' '))
+        {
+            let Some(font_face_rule) = template.template.font_face_rule() else {
+                return;
+            };
+            match font_face_rule.load_state() {
+                WebFontLoadState::Unloaded => {
+                    font_context.request_web_font_load(&font_face_rule);
+                    return;
+                },
+                WebFontLoadState::Loading | WebFontLoadState::Loaded => return,
+                WebFontLoadState::Failed => {},
+            }
         }
     }
 
diff --git a/components/fonts/font_context.rs b/components/fonts/font_context.rs
index 62f29de37a2..44369799bc0 100644
--- a/components/fonts/font_context.rs
+++ b/components/fonts/font_context.rs
@@ -218,6 +218,16 @@ impl FontContext {
         }
     }
 
+    /// Ask for the first available font for `style` to be loaded if it is a web font that has
+    /// not been fetched yet. See [`FontGroup::request_first_available_web_font`].
+    pub fn request_first_available_web_font(&self, style: ServoArc<FontStyleStruct>) {
+        if self.web_fonts.read().families.is_empty() {
+            return;
+        }
+        self.font_group(style)
+            .request_first_available_web_font(self);
+    }
+
     /// Returns a `FontGroup` representing fonts which can be used for layout, given the `style`.
     /// Font groups are cached, so subsequent calls with the same `style` will return a reference
     /// to an existing `FontGroup`.
diff --git a/components/layout/traversal.rs b/components/layout/traversal.rs
index d3c328f9755..5c0b73e86ec 100644
--- a/components/layout/traversal.rs
+++ b/components/layout/traversal.rs
@@ -10,6 +10,7 @@ use layout_api::{
 use script::layout_dom::ServoLayoutNode;
 use style::context::{SharedStyleContext, StyleContext};
 use style::dom::{NodeInfo, TElement, TNode};
+use style::properties::ComputedValues;
 use style::selector_parser::RestyleDamage;
 use style::traversal::{DomTraversal, PerLevelTraversalData, recalc_style_at};
 
@@ -67,6 +68,18 @@ where
             &mut element_data,
             note_child,
         );
+
+        // The first available font of an element is needed even if it has no text, for
+        // instance for `line-height: normal`, so make sure that it gets loaded. Fonts are
+        // inherited, so only elements that change them need to be looked at.
+        if let Some(style) = element_data.styles.get_primary() &&
+            !style.get_box().display.is_none() &&
+            !parent_has_same_font(dangerous_style_element, style)
+        {
+            self.context
+                .font_context
+                .request_first_available_web_font(style.clone_font());
+        }
     }
 
     #[inline]
@@ -83,6 +96,19 @@ where
     }
 }
 
+fn parent_has_same_font<E: TElement>(element: E, style: &ComputedValues) -> bool {
+    let Some(parent) = element.traversal_parent() else {
+        return false;
+    };
+    let Some(parent_data) = parent.borrow_data() else {
+        return false;
+    };
+    parent_data
+        .styles
+        .get_primary()
+        .is_some_and(|parent_style| std::ptr::eq(parent_style.get_font(), style.get_font()))
+}
+
 #[servo_tracing::instrument(skip_all)]
 pub(crate) fn compute_damage_and_rebuild_box_tree<'dom>(
     box_tree: &mut Option<Arc<BoxTree>>,
