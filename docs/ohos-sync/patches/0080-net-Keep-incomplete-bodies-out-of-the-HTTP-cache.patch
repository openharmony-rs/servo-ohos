+    let request = build_request_with_range(Destination::None, Some("bytes=2-"));
+    let response = build_cacheable_response(&request, ResponseBody::Done(b"0123456789".to_vec()));
+    let cache = HttpCache::new(HttpCacheAssignment::Public);
