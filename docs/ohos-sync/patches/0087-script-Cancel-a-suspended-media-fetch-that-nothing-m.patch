@@ -3084,6 +3087,7 @@ impl Document {
         self.deferred_scripts.clear();
 
         let global = self.window.as_global_scope();
+        self.cancel_suspended_media_fetches();
         let loads_cancelled = global.fetch_group_mut().terminate(global);
