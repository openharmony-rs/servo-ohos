From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Schwender <schwenderjonathan@gmail.com>
Date: Sun, 15 Nov 2026 07:15:00 +0000
Subject: [PATCH] storage: Test the transaction and statement behaviour the
 executors rely on
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The executor layer and the database actor planned on top of it assume
things about RDB that had only been read in the relational_store sources.
They were checked on the DAYU200 with a probe, and these tests keep the
ones the code depends on, so that a change in RDB or in the bundled
SQLite shows up as a failing test rather than as lost data.

On every executor:

- BEGIN IMMEDIATE takes the write lock when the transaction begins: a
  second writer can't begin until the busy timeout runs out, while a
  deferred transaction still begins and reads the last commit. RDB's
  timeout is 2 s; a store-level `PRAGMA busy_timeout` doesn't reach the
  connections its transactions run on, so the 100 ms the test sets only
  shortens the wait on SQLite.
- A deferred transaction reads one snapshot, taken by its first read,
  in WAL mode as the engine uses it.
- Every kind of statement the IndexedDB layer runs (CREATE TABLE and
  INDEX, ALTER, DROP, INSERT, UPDATE, DELETE, a PRAGMA that sets a value,
  queries, a PRAGMA that reads one) works inside a transaction and
  outside one, also with leading whitespace as in schema.rs.
- A constraint violation fails its statement only; the transaction goes
  on and commits the rest.

On RDB only:

- in a transaction, execute calls accept SAVEPOINT and ROLLBACK TO but
  reject RELEASE with RDB_E_INVALID_ARGS, which is why the layer uses no
  savepoints (the statements RDB rejects on every path are covered on
  both executors since the SQLite executor refuses them too);
- constraint violations report RDB_E_SQLITE_CONSTRAINT;
- an IMMEDIATE transaction stays usable across calls from one thread
  through more than three minutes with a 160 s idle gap, past the 150 s
  after which RDB closes unused pooled transaction connections. The
  database actor keeps transactions open like this while script runs.
  The test is #[ignore]d because of its length; run it with
  `--run-ignored only` and a nextest slow-timeout above 200 s.

Validation: host `cargo nextest run -p servo-storage -p servo-storage-traits`: 83 passed. DAYU200 `./mach test-unit --ohos -p servo-storage -- --no-default-features --features ohos-rdb-backend --status-level all`: 84 passed, 2 skipped (the documented test_new_storage_threads_create_independent_groups and the ignored long test); with both backends 138 passed, 2 skipped. The long test alone (`… -- --config-file <nextest.toml with slow-timeout 60s × 10> --no-default-features --features ohos-rdb-backend --run-ignored only -E 'test(/transaction_stays_open_across_idle_minutes/)'`): 1 passed in 182.7 s. `./mach check --ohos -- -p servo-storage --all-targets` warning-free in the three configurations. WPT IndexedDB/ with the whole P0 series applied, as measured for "indexeddb: Run the SQLite and RDB backends as executors of one engine": host SpiderMonkey 3,224, host QuickJS 3,229 and DAYU200 3,222 passing subtests of 4,511, every unexpected result also seen with the baseline build; idbtransaction-oncomplete 60 of 60.
AI-assisted: Yes (agent session; the agent probed RDB on the DAYU200, wrote the tests and ran them on the host and the board; after a review, it moved the statement rejections to the tests of every executor and measured again)
Signed-off-by: Jonathan Schwender <schwenderjonathan@gmail.com>
---
 components/storage/indexeddb/backend/rdb.rs   | 88 ++++++++++++++++++
 components/storage/indexeddb/backend/tests.rs | 92 +++++++++++++++++++
 2 files changed, 180 insertions(+)

diff --git a/components/storage/indexeddb/backend/rdb.rs b/components/storage/indexeddb/backend/rdb.rs
index 711f5bf91c9..7c2ccf5f27b 100644
--- a/components/storage/indexeddb/backend/rdb.rs
+++ b/components/storage/indexeddb/backend/rdb.rs
@@ -257,3 +257,91 @@ impl SqlExecutor for RdbExecutor {
         0
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use std::time::{Duration, Instant};
+
+    use super::*;
+    use crate::indexeddb::backend::executor::query_rows;
+
+    fn open(dir: &Path) -> RdbExecutor {
+        let mut executor = RdbExecutor::open(dir).unwrap();
+        executor
+            .execute("CREATE TABLE t (k INTEGER PRIMARY KEY)", &[])
+            .unwrap();
+        executor
+    }
+
+    fn insert(executor: &mut RdbExecutor, key: i64) -> Result<u64, SqlError> {
+        executor.execute("INSERT INTO t (k) VALUES (?)", &[SqlParam::Integer(key)])
+    }
+
+    fn keys(executor: &mut RdbExecutor) -> Vec<i64> {
+        query_rows(executor, "SELECT k FROM t ORDER BY k", &[], |row| {
+            row.integer(0)
+        })
+        .unwrap()
+    }
+
+    fn code(error: SqlError) -> i32 {
+        match error {
+            SqlError::Rdb(OhosRdbError::Api { code, .. }) => code,
+            other => panic!("not an RDB API error: {other:?}"),
+        }
+    }
+
+    /// In a transaction, RDB's execute runs `SAVEPOINT` and `ROLLBACK TO` but rejects `RELEASE`,
+    /// so the IndexedDB layer uses no savepoints; the SQLite executor refuses all three.
+    #[test]
+    fn accepts_savepoints_but_rejects_release() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut executor = open(dir.path());
+        executor.begin(TransactionBehavior::Immediate).unwrap();
+        insert(&mut executor, 1).unwrap();
+        executor.execute("SAVEPOINT s", &[]).unwrap();
+        insert(&mut executor, 2).unwrap();
+        executor.execute("ROLLBACK TO s", &[]).unwrap();
+        assert_eq!(
+            code(executor.execute("RELEASE s", &[]).unwrap_err()),
+            OH_Rdb_ErrCode::RDB_E_INVALID_ARGS.0
+        );
+        executor.commit().unwrap();
+        assert_eq!(keys(&mut executor), vec![1]);
+    }
+
+    #[test]
+    fn reports_constraint_violations_as_sqlite_constraint() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut executor = open(dir.path());
+        insert(&mut executor, 1).unwrap();
+        let constraint = OH_Rdb_ErrCode::RDB_E_SQLITE_CONSTRAINT.0;
+        assert_eq!(code(insert(&mut executor, 1).unwrap_err()), constraint);
+        executor.begin(TransactionBehavior::Immediate).unwrap();
+        assert_eq!(code(insert(&mut executor, 1).unwrap_err()), constraint);
+        executor.commit().unwrap();
+    }
+
+    /// The database actor keeps a write transaction open while script runs. RDB closes its pooled
+    /// transaction connections after 150 s unused; an open transaction must survive that. Takes
+    /// more than three minutes, so it runs only with `--run-ignored only` and a raised nextest
+    /// slow-timeout.
+    #[test]
+    #[ignore]
+    fn transaction_stays_open_across_idle_minutes() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut executor = open(dir.path());
+        let mut other = executor.connector()().unwrap();
+        let start = Instant::now();
+        executor.begin(TransactionBehavior::Immediate).unwrap();
+        for (key, idle_seconds) in [(1, 160), (2, 20), (3, 0)] {
+            insert(&mut executor, key).unwrap();
+            assert_eq!(keys(&mut other), Vec::<i64>::new());
+            std::thread::sleep(Duration::from_secs(idle_seconds));
+        }
+        assert_eq!(keys(&mut executor), vec![1, 2, 3]);
+        executor.commit().unwrap();
+        assert!(start.elapsed() > Duration::from_secs(180));
+        assert_eq!(keys(&mut other), vec![1, 2, 3]);
+    }
+}
diff --git a/components/storage/indexeddb/backend/tests.rs b/components/storage/indexeddb/backend/tests.rs
index 6b805af620c..4bb80377076 100644
--- a/components/storage/indexeddb/backend/tests.rs
+++ b/components/storage/indexeddb/backend/tests.rs
@@ -66,6 +66,9 @@ executor_tests!(
     executor_disk_full_maps_to_quota_exceeded,
     executor_disk_full_ends_the_transaction,
     executor_failing_query_reports_the_transaction_state,
+    executor_constraint_violation_keeps_the_transaction,
+    executor_immediate_locks_at_begin_and_deferred_reads_a_snapshot,
+    executor_runs_each_kind_of_statement,
     executor_user_version_is_transactional_and_persistent,
     executor_delete_removes_the_database,
     schema_version_is_stamped_on_a_new_database,
@@ -152,6 +155,13 @@ fn open_executor<X: SqlExecutor>(dir: &Path) -> X {
     executor
 }
 
+/// An executor like [`open_executor`]'s, in WAL mode like the engine's databases.
+fn open_wal_executor<X: SqlExecutor>(dir: &Path) -> X {
+    let mut executor = open_executor::<X>(dir);
+    executor.execute("PRAGMA journal_mode = WAL", &[]).unwrap();
+    executor
+}
+
 fn insert_into_t<X: SqlExecutor>(executor: &mut X, key: i64) {
     executor
         .execute("INSERT INTO t (k) VALUES (?)", &[SqlParam::Integer(key)])
@@ -358,6 +368,88 @@ fn executor_failing_query_reports_the_transaction_state<X: SqlExecutor>() {
     }
 }
 
+fn executor_constraint_violation_keeps_the_transaction<X: SqlExecutor>() {
+    let dir = tempfile::tempdir().unwrap();
+    let mut executor = open_executor::<X>(dir.path());
+    insert_into_t(&mut executor, 1);
+    executor.begin(TransactionBehavior::Immediate).unwrap();
+    insert_into_t(&mut executor, 2);
+    assert!(
+        executor
+            .execute("INSERT INTO t (k) VALUES (1)", &[])
+            .is_err()
+    );
+    assert!(executor.in_transaction());
+    insert_into_t(&mut executor, 3);
+    executor.commit().unwrap();
+    assert_eq!(keys_in_t(&mut executor), vec![1, 2, 3]);
+}
+
+fn executor_immediate_locks_at_begin_and_deferred_reads_a_snapshot<X: SqlExecutor>() {
+    let dir = tempfile::tempdir().unwrap();
+    let mut a = open_wal_executor::<X>(dir.path());
+    let mut b = a.connector()().unwrap();
+    // A second writer fails once the busy timeout has run out. RDB's transactions wait 2 s
+    // whatever this sets.
+    b.execute("PRAGMA busy_timeout = 100", &[]).unwrap();
+    insert_into_t(&mut a, 1);
+
+    // The write lock is taken before the transaction writes, so a second writer can't begin.
+    a.begin(TransactionBehavior::Immediate).unwrap();
+    assert!(b.begin(TransactionBehavior::Immediate).is_err());
+    assert!(!b.in_transaction());
+    b.begin(TransactionBehavior::Deferred).unwrap();
+    assert_eq!(keys_in_t(&mut b), vec![1]);
+    b.commit().unwrap();
+    a.commit().unwrap();
+
+    // A deferred transaction reads one snapshot, taken by its first read.
+    a.begin(TransactionBehavior::Deferred).unwrap();
+    insert_into_t(&mut b, 2);
+    assert_eq!(keys_in_t(&mut a), vec![1, 2]);
+    insert_into_t(&mut b, 3);
+    assert_eq!(keys_in_t(&mut a), vec![1, 2]);
+    a.commit().unwrap();
+    assert_eq!(keys_in_t(&mut a), vec![1, 2, 3]);
+}
+
+/// The kinds of statement that the IndexedDB layer runs, inside a transaction and outside one.
+fn executor_runs_each_kind_of_statement<X: SqlExecutor>() {
+    let dir = tempfile::tempdir().unwrap();
+    let mut executor = open_executor::<X>(dir.path());
+    for in_transaction in [false, true] {
+        if in_transaction {
+            executor.begin(TransactionBehavior::Immediate).unwrap();
+        }
+        for statement in [
+            "\n  CREATE TABLE s (x INTEGER PRIMARY KEY)",
+            "CREATE INDEX s_x ON s (x)",
+            "ALTER TABLE s ADD COLUMN y INTEGER",
+            "INSERT INTO s (x) VALUES (1)",
+            "INSERT INTO s (x) VALUES (2)",
+            "UPDATE s SET y = 3",
+            "DELETE FROM s WHERE x = 2",
+            "PRAGMA user_version = 4",
+            "DROP INDEX s_x",
+        ] {
+            if let Err(error) = executor.execute(statement, &[]) {
+                panic!("{statement:?} in a transaction: {in_transaction}: {error:?}");
+            }
+        }
+        let rows = query_rows(&mut executor, "SELECT x, y FROM s", &[], |row| {
+            Ok((row.integer(0)?, row.integer(1)?))
+        })
+        .unwrap();
+        assert_eq!(rows, vec![(1, 3)]);
+        assert_eq!(schema::stored_schema_version(&mut executor).unwrap(), 4);
+        executor.execute("DROP TABLE s", &[]).unwrap();
+        if in_transaction {
+            executor.commit().unwrap();
+        }
+        assert!(!has_table(&mut executor, "s"));
+    }
+}
+
 fn executor_user_version_is_transactional_and_persistent<X: SqlExecutor>() {
     let dir = tempfile::tempdir().unwrap();
     let mut executor = open_executor::<X>(dir.path());
