@@ -21,7 +21,7 @@ index dcda11e2c..0fa2abc83 100644
          WVLOG_I("CalculateActiveWebEngineVersion, enforce %{public}d", webEngineEnforce);
          return static_cast<ArkWebEngineVersion>(webEngineEnforce);
      }
-@@ -550,6 +553,11 @@ bool IsActiveWebEngineEvergreen()
+@@ -586,6 +589,11 @@ bool IsActiveWebEngineEvergreen()
      return false;
