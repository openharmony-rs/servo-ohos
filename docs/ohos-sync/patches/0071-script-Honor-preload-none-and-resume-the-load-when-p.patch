+        self.delay_load_event(cx, true);
+
+        // Step 5.remote.1.7. Set the networkState to NETWORK_LOADING.
+        self.set_network_state(NetworkState::Loading);
+
+        self.fetch_resource(cx, Resource::Url(url));
+    }
