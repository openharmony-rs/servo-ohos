From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Schwender <schwenderjonathan@gmail.com>
Date: Wed, 4 Nov 2026 09:57:25 +0000
Subject: [PATCH] script: Run debugger.js on QuickJS

servo-quickjs now emulates SpiderMonkey's Debugger API, so the debugger
global defines it and runs debugger.js on QuickJS too. Before, console
evaluations, autocompletion and source lists of the QuickJS build waited
forever for debugger.js to reply. While paused, each devtools message
releases what it kept alive in QuickJS's autorelease pool.

The servo-quickjs pin moves from 544db84, where JS_DefineDebuggerObject
is a stub that panics in every script thread of builds with devtools,
to f25a0d3, which has the emulation.

Validation: QuickJS builds against servo-quickjs f25a0d3: `./mach test-devtools` passes 87 tests with 7 expected failures, as with SpiderMonkey, in release and checked-release (19 passed before).
AI-assisted: Yes (agent session; written and tested by the agent, reviewed by another agent)
Signed-off-by: Jonathan Schwender <schwenderjonathan@gmail.com>
---
 components/script/dom/debugger/debuggerglobalscope.rs | 9 +--------
 components/script/event_loop/script_thread.rs         | 5 +++++
 support/quickjs/cargo-config.toml                     | 2 +-
 3 files changed, 7 insertions(+), 9 deletions(-)

diff --git a/components/script/dom/debugger/debuggerglobalscope.rs b/components/script/dom/debugger/debuggerglobalscope.rs
index 5e8db17f4b7..06e05f81ffc 100644
--- a/components/script/dom/debugger/debuggerglobalscope.rs
+++ b/components/script/dom/debugger/debuggerglobalscope.rs
@@ -14,12 +14,10 @@ use dom_struct::dom_struct;
 use embedder_traits::ScriptToEmbedderChan;
 use embedder_traits::resources::{self, Resource};
 use js::context::JSContext;
-#[cfg(not(feature = "js-quickjs"))]
 use js::rust::wrappers2::JS_DefineDebuggerObject;
 use net_traits::ResourceThreads;
 use profile_traits::{mem, time};
 use script_bindings::interfaces::HasOrigin;
-#[cfg(not(feature = "js-quickjs"))]
 use script_bindings::reflector::DomObject;
 use servo_base::generic_channel::{GenericCallback, GenericSender, channel};
 use servo_base::id::{Index, PipelineId, PipelineNamespaceId, WorkerId};
@@ -90,7 +88,7 @@ impl DebuggerGlobalScope {
     ///   pipeline ids, and they may contain debuggees from more than one pipeline
     /// - in web worker threads, it should be set to the pipeline id of the page that created the thread, because
     ///   those threads can’t generate pipeline ids, and they only contain one debuggee from one pipeline
-    #[cfg_attr(not(feature = "js-quickjs"), expect(unsafe_code))]
+    #[expect(unsafe_code)]
     #[expect(clippy::too_many_arguments)]
     pub(crate) fn new(
         debugger_pipeline_id: PipelineId,
@@ -136,7 +134,6 @@ impl DebuggerGlobalScope {
         let mut realm = enter_auto_realm(cx, &*global);
         let mut realm = realm.current_realm();
         define_all_exposed_interfaces(&mut realm, global.upcast());
-        #[cfg(not(feature = "js-quickjs"))]
         assert!(unsafe {
             // Invariants: `obj` must be a handle to a JS global object.
             JS_DefineDebuggerObject(&mut realm, global.global_scope.reflector().get_jsobject())
@@ -154,10 +151,6 @@ impl DebuggerGlobalScope {
     }
 
     pub(crate) fn execute(&self, cx: &mut JSContext) {
-        // QuickJS has no Debugger API.
-        if cfg!(feature = "js-quickjs") {
-            return;
-        }
         let mut realm = enter_auto_realm(cx, self);
         let cx = &mut realm.current_realm();
 
diff --git a/components/script/event_loop/script_thread.rs b/components/script/event_loop/script_thread.rs
index cc12662c400..f959a9db21e 100644
--- a/components/script/event_loop/script_thread.rs
+++ b/components/script/event_loop/script_thread.rs
@@ -2354,6 +2354,11 @@ impl ScriptThread {
         let mut cx = unsafe { js::context::JSContext::from_ptr(js::rust::Runtime::get().unwrap()) };
 
         while self.debugger_paused.get() {
+            // QuickJS: release what each message kept alive in the autorelease pool, instead of
+            // when the paused task ends.
+            #[cfg(feature = "js-quickjs")]
+            #[allow(unsafe_code)]
+            let _pool_scope = unsafe { js::quickjs::AutoreleasePoolScope::new() };
             match self.receivers.devtools_server_receiver.recv() {
                 Ok(Ok(msg)) => self.handle_msg_from_devtools(&mut cx, msg),
                 _ => {
diff --git a/support/quickjs/cargo-config.toml b/support/quickjs/cargo-config.toml
index 9af11c534c7..c24f216bf87 100644
--- a/support/quickjs/cargo-config.toml
+++ b/support/quickjs/cargo-config.toml
@@ -5,4 +5,4 @@
 # were tested with. The shim's version must match the mozjs version that Cargo.toml requires, or
 # Cargo leaves the patch unused.
 [patch.crates-io]
-mozjs = { git = "https://github.com/openharmony-rs/servo-quickjs", rev = "544db84d9210b332e98baa8bb39a51c4c769001d" }
+mozjs = { git = "https://github.com/openharmony-rs/servo-quickjs", rev = "f25a0d3b4948a6e199a21c6af433ef332ef80606" }
