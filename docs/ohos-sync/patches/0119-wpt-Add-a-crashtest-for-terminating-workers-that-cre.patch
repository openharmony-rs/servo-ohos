diff --git a/tests/wpt/tests/workers/Worker-terminate-while-creating-promises-crash.html b/tests/wpt/tests/workers/Worker-terminate-while-creating-promises-crash.html
new file mode 100644
index 00000000000..dab5cd7d7d2
--- /dev/null
+++ b/tests/wpt/tests/workers/Worker-terminate-while-creating-promises-crash.html
@@ -0,0 +1,26 @@
+<!DOCTYPE html>
+<html class="test-wait">
+<meta charset="utf-8">
+<title>Terminating workers while they create promises in platform code</title>
+<link rel="help" href="https://html.spec.whatwg.org/multipage/workers.html#terminate-a-worker">
+<script>
+  // Each worker keeps calling APIs that create promises, so termination likely stops it inside one
+  // of them. The worker threads may still be stopping after terminate() returns, so the test waits
+  // a little longer.
+  const workers = [];
+  let started = 0;
+  for (let i = 0; i < 8; i++) {
+    const worker = new Worker("support/Worker-create-promises.js");
+    worker.onmessage = async () => {
+      if (++started < workers.length)
+        return;
+      for (const w of workers)
+        w.terminate();
+      const start = performance.now();
+      while (performance.now() - start < 200)
+        await new Promise(resolve => requestAnimationFrame(resolve));
+      document.documentElement.classList.remove("test-wait");
+    };
+    workers.push(worker);
+  }
+</script>
diff --git a/tests/wpt/tests/workers/support/Worker-create-promises.js b/tests/wpt/tests/workers/support/Worker-create-promises.js
new file mode 100644
index 00000000000..d14d3a06b11
--- /dev/null
+++ b/tests/wpt/tests/workers/support/Worker-create-promises.js
@@ -0,0 +1,12 @@
+// Creates promises in platform code until terminated, for at most 10 seconds: the start promise of
+// a stream and the promise of a read waiting for a chunk. Awaiting between batches runs the queued
+// reactions, so the streams can be collected.
+postMessage("started");
+(async () => {
+  const end = performance.now() + 10000;
+  while (performance.now() < end) {
+    for (let i = 0; i < 100; i++)
+      new ReadableStream().getReader().read();
+    await null;
+  }
+})();
