diff --git a/components/script/dom/fetch/response.rs b/components/script/dom/fetch/response.rs
index efe729ce87c..4e25ef46822 100644
--- a/components/script/dom/fetch/response.rs
+++ b/components/script/dom/fetch/response.rs
@@ -114,9 +114,15 @@ impl Response {
     }
 
     pub(crate) fn error_stream(&self, cx: &mut js::context::JSContext, error: Error) {
-        if let Some(body) = self.fetch_body_stream.get() {
+        if let Some(body) = self.fetch_body_stream.get() &&
+            body.is_readable()
+        {
             body.error_native(cx, error);
         }
+        let stream_consumer = self.stream_consumer.borrow_mut().take();
+        if let Some(stream_consumer) = stream_consumer {
+            stream_consumer.stream_error();
+        }
     }
 
     pub(crate) fn is_disturbed(&self) -> bool {
@@ -551,8 +557,16 @@ impl Response {
 
     pub(crate) fn stream_chunk(&self, cx: &mut js::context::JSContext, chunk: Bytes) {
         // Note, are these two actually mutually exclusive?
-        if let Some(stream_consumer) = self.stream_consumer.borrow().as_ref() {
-            stream_consumer.consume_chunk(&chunk);
+        let consumed = self
+            .stream_consumer
+            .borrow()
+            .as_ref()
+            .map(|stream_consumer| stream_consumer.consume_chunk(&chunk));
+        if let Some(consumed) = consumed {
+            // SpiderMonkey has ended a consumer that refuses a chunk, which must not be used again.
+            if !consumed {
+                self.stream_consumer.borrow_mut().take();
+            }
         } else if let Some(body) = self.fetch_body_stream.get() {
             body.enqueue_native(cx, chunk.to_vec());
         }
diff --git a/components/script/fetch/fetch.rs b/components/script/fetch/fetch.rs
index 52617bec2b4..ee148c5dc78 100644
--- a/components/script/fetch/fetch.rs
+++ b/components/script/fetch/fetch.rs
@@ -694,11 +694,12 @@ impl FetchCallState {
     ) {
         let mut realm = enter_auto_realm(cx, &*self.response);
         let cx = &mut realm.current_realm();
-        if let Err(NetworkError::DecompressionError) = response {
+        if response.is_err() {
             self.response
                 .error_stream(cx, Error::Type(c"Network error occurred".to_owned()));
+        } else {
+            self.response.finish(cx);
         }
-        self.response.finish(cx);
         // TODO
         // ... trailerObject is not supported in Servo yet.
     }
diff --git a/components/script/runtime/script_runtime.rs b/components/script/runtime/script_runtime.rs
index 82187ddc386..bf0041979b3 100644
--- a/components/script/runtime/script_runtime.rs
+++ b/components/script/runtime/script_runtime.rs
@@ -24,9 +24,9 @@ use js::context::JSContext;
 use js::conversions::jsstr_to_string;
 use js::gc::StackGCVector;
 use js::glue::{
-    DispatchablePointer, RUST_js_GetErrorMessage, RegisterScriptEnvironmentPreparer,
-    RunScriptEnvironmentPreparerClosure, SetBuildId, StreamConsumerConsumeChunk,
-    StreamConsumerNoteResponseURLs, StreamConsumerStreamEnd, StreamConsumerStreamError,
+    DispatchablePointer, RegisterScriptEnvironmentPreparer, RunScriptEnvironmentPreparerClosure,
+    SetBuildId, StreamConsumerConsumeChunk, StreamConsumerNoteResponseURLs,
+    StreamConsumerStreamEnd, StreamConsumerStreamError,
 };
 use js::jsapi::{
     AsmJSOption, BuildIdCharVector, CompilationType, Dispatchable_MaybeShuttingDown, GCDescription,
@@ -1227,9 +1227,11 @@ impl StreamConsumer {
         }
     }
 
-    pub(crate) fn stream_error(&self, error_code: usize) {
+    /// Ends the stream because the body ended with a network error, which rejects the
+    /// compilation with the TypeError thrown by `report_stream_error`.
+    pub(crate) fn stream_error(&self) {
         unsafe {
-            StreamConsumerStreamError(self.0, error_code);
+            StreamConsumerStreamError(self.0, STREAM_NETWORK_ERROR);
         }
     }
 
@@ -1345,11 +1347,27 @@ unsafe extern "C" fn consume_stream(
     true
 }
 
+/// The error code `StreamConsumer::stream_error` passes to SpiderMonkey, which hands it back to
+/// `report_stream_error`. SpiderMonkey reserves 0 for out of memory.
+const STREAM_NETWORK_ERROR: usize = 1;
+
+/// SpiderMonkey rejects the compilation with the exception this leaves pending, and leaves the
+/// promise unsettled if there is none.
 #[expect(unsafe_code)]
-unsafe extern "C" fn report_stream_error(_cx: *mut RawJSContext, error_code: usize) {
-    error!("Error initializing StreamConsumer: {:?}", unsafe {
-        RUST_js_GetErrorMessage(ptr::null_mut(), error_code as u32)
-    });
+unsafe extern "C" fn report_stream_error(cx: *mut RawJSContext, error_code: usize) {
+    debug_assert_eq!(error_code, STREAM_NETWORK_ERROR);
+    let mut cx = unsafe {
+        // SAFETY: We are in SM hook
+        JSContext::from_ptr(NonNull::new(cx).expect("JSContext should not be null in SM hook"))
+    };
+    let cx = &mut cx;
+    let mut realm = CurrentRealm::assert(cx);
+    let global = GlobalScope::from_current_realm(&mut realm);
+    throw_dom_exception(
+        cx,
+        &global,
+        Error::Type(c"Network error occurred".to_owned()),
+    );
 }
 
 #[expect(unsafe_code)]
