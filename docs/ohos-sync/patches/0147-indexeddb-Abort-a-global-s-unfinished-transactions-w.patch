--- /dev/null
+++ b/tests/wpt/mozilla/tests/IndexedDB/resources/removed-iframe-writer.html
@@ -0,0 +1,20 @@
+<!doctype html>
+<meta charset="utf-8">
+<script>
+// Keeps a readwrite transaction on the store `a` alive with chained puts, until the frame goes
+// away.
+const name = decodeURIComponent(location.search.slice(1));
+const request = indexedDB.open(name);
+request.onsuccess = () => {
+  const store = request.result.transaction('a', 'readwrite').objectStore('a');
+  let key = 0;
+  (function put() {
+    store.put('frame', key++).onsuccess = () => {
+      if (key === 1) {
+        parent.postMessage('writing', '*');
+      }
+      put();
+    };
+  })();
+};
+</script>
