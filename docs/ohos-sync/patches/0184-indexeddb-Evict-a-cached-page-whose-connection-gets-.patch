diff --git a/components/script/tasks/task_source.rs b/components/script/tasks/task_source.rs
index dfa78eff596..a91e9e502a3 100644
--- a/components/script/tasks/task_source.rs
+++ b/components/script/tasks/task_source.rs
@@ -202,6 +202,28 @@ impl SendableTaskSource {
             );
